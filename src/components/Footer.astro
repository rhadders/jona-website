---
import { ui } from "../i18n/ui";
import { MAATWERK, taalUitPad } from "../i18n/talen";
import { beschikbaar, link } from "../lib/paginas";
import { app } from "../i18n/apps";
const year = new Date().getFullYear();
const taal = taalUitPad(Astro.url.pathname);
const t = ui(taal);
// Alleen apps die in deze taal te gebruiken zijn (ActueleGegevens.nl is alleen Nederlands).
const apps = [
  { id: "jonagiften", naam: app("jonagiften", taal).naam },
  { id: "jonabestuur", naam: app("jonabestuur", taal).naam },
  { id: "selaread", naam: "Selaread" },
  { id: "actuelegegevens", naam: "ActueleGegevens.nl" },
  { id: "tirgumai", naam: "TirgumAI" },
].filter((a) => beschikbaar(a.id, taal));
---
<footer class="site-footer on-navy">
  <div class="wrap stack gap-48">
    <div class="cols">
      <div class="stack gap-16">
        <img src="/logo/jona-logo-wit.svg" alt={t.logoAlt.replace(" ·", "")} width="200" height="70" class="logo">
        <p class="tagline">{t.voet.tagline}</p>
      </div>
      <div class="col">
        <span class="eyebrow light">{t.voet.software}</span>
        {apps.map((a) => <a href={link(a.id, taal)}>{a.naam}</a>)}
        <a href={link("software", taal)}>{t.voet.alleSoftware}</a>
      </div>
      <div class="col">
        <span class="eyebrow light">{t.voet.jona}</span>
        <a href={link("over-jona", taal)}>{t.nav.over}</a>
        {MAATWERK[taal] ? (
          <>
            <a href={link("ai-scan", taal)}>{t.nav.aiScan}</a>
            <a href={link("advies", taal)}>{t.kennismaking}</a>
          </>
        ) : (
          <a href={link("over-jona", taal, "advies")}>{t.kennismaking}</a>
        )}
      </div>
      <div class="col">
        <span class="eyebrow light">{t.voet.adres}</span>
        <span>{t.voet.adresRegel}</span>
        <span>T: <a href="tel:+31615943200">{t.voet.telefoon}</a></span>
        <span>E: <a href="mailto:info@jonatechnologie.nl">info@jonatechnologie.nl</a></span>
      </div>
    </div>
    <div class="bottom">
      {MAATWERK[taal] && <span>{t.voet.jointVenture} <a href="https://echonova.nl" target="_blank" rel="noopener">EchoNova</a>.</span>}
      <span>&copy; {year} Jona zinvolle technologie</span>
      <span>{t.voet.kvk}: 72450355</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: var(--ink-on-navy);
    padding: 64px 0 40px;
    margin-top: auto;
  }
  .logo { display: block; height: 56px; width: auto; }
  .tagline { font-size: 15px; max-width: 32ch; }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
  }
  .col a { text-decoration: none; }
  .col a:hover { color: var(--teal-300); }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 14px;
  }
</style>
