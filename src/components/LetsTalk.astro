---
// Het navy "Let's talk"-blok met het korte kennismakingsformulier.
import Icon from "./Icon.astro";
import { ui } from "../i18n/ui";
import { taalUitPad } from "../i18n/talen";
import { BEDANKT } from "../lib/paginas";
interface Props { id?: string }
const { id = "advies" } = Astro.props;
const taal = taalUitPad(Astro.url.pathname);
const t = ui(taal).letsTalk;
---
<section id={id} class="letstalk">
  <div class="wrap">
    <div class="panel on-navy">
      <img src="/logo/jona-mark.svg" alt="" aria-hidden="true" class="watermark" width="560" height="560">
      <div class="stack gap-20 intro">
        <p class="eyebrow">Let's talk</p>
        <h2 class="h2-lt">{t.kop}</h2>
        <p class="lead-lt">{t.tekst}</p>
      </div>
      <form class="form" method="post" action="/api/kennismaking" data-form="kennismaking" data-bedankt={BEDANKT[taal]} novalidate>
        <input type="hidden" name="_bron" value="">
        <input type="hidden" name="_taal" value={taal}>
        <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="row">
          <div class="field">
            <label for={`${id}-naam`}>{t.naam}</label>
            <input id={`${id}-naam`} name="naam" type="text" autocomplete="name" required>
            <span class="err" data-error-for="naam"></span>
          </div>
          <div class="field">
            <label for={`${id}-organisatie`}>{t.organisatie}</label>
            <input id={`${id}-organisatie`} name="organisatie" type="text" autocomplete="organization">
          </div>
        </div>
        <div class="field">
          <label for={`${id}-email`}>{t.email}</label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" required>
          <span class="err" data-error-for="email"></span>
        </div>
        <div class="field">
          <label for={`${id}-bericht`}>{t.bericht}</label>
          <textarea id={`${id}-bericht`} name="bericht" rows="4" placeholder={t.berichtHint}></textarea>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
        <button type="submit" class="btn btn-accent self-start"><span>{t.knop}</span> <Icon name="arrow-right" /></button>
        <p class="note">{t.privacy}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .letstalk { padding: 0 0 96px; }
  .panel {
    position: relative;
    overflow: hidden;
    background: var(--navy-800);
    border-radius: var(--r-dialog);
    padding: 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 48px;
    align-items: start;
  }
  .watermark {
    position: absolute;
    bottom: -200px;
    right: -160px;
    width: 560px;
    height: 560px;
    opacity: 0.08;
    filter: brightness(0) invert(1);
    pointer-events: none;
  }
  .intro, .form { position: relative; }
  .h2-lt {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3.2vw, 36px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }
  .lead-lt { font-size: 19px; color: var(--ink-on-navy); max-width: 44ch; }
  .self-start { align-self: flex-start; }
  .err { font-size: 13px; color: var(--teal-300); min-height: 0; }
  .err:empty { display: none; }
  @media (max-width: 767px) {
    .letstalk { padding-bottom: 64px; }
    .panel { padding: 36px 24px; border-radius: var(--r-card); }
  }
  @media (max-width: 479px) {
    .panel { grid-template-columns: minmax(0, 1fr); }
  }
</style>
