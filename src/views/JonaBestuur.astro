---
// De pagina Jona Bestuur, één opmaak voor alle talen. De teksten staan in
// src/teksten/jonabestuur/<taal>.ts; de routes in src/pages/<taal>/jonabestuur.astro.
// De opbouw volgt die van Jona Giften (src/views/JonaGiften.astro).
import { link, pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { bedrag, type Taal } from "../i18n/talen";
import { app, kaalAdres } from "../i18n/apps";
import { nl } from "../teksten/jonabestuur/nl";
import { en } from "../teksten/jonabestuur/en";
import { de } from "../teksten/jonabestuur/de";

interface Props { taal: Taal }
const { taal } = Astro.props;
const t = { nl, en, de }[taal];

// Naam en websites van de app verschillen per taal (src/i18n/apps.ts).
const APP = app("jonabestuur", taal);
const AANMELDEN = APP.aanmelden;
import { beeld } from "../i18n/beelden";
---
<Base
  {...pagina(link("jonabestuur", taal))}
  current="software"
>
  <section class="hero">
    <div class="wrap stack gap-56">
      <nav aria-label={t.kruimelpad} class="crumbs">
        <a href={link("software", taal)}>{t.software}</a>
        <Icon name="chevron-right" size={14} />
        <span>{APP.naam}</span>
      </nav>
      <div class="narrow stack gap-24">
        <span class="tag">{t.hero.tag}</span>
        <h1 class="h1 h1-sm">{t.hero.kop}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a href={AANMELDEN} rel="noopener" class="btn btn-primary"><span>{t.hero.knopProberen}</span> <Icon name="arrow-right" /></a>
          <a href={APP.site} rel="noopener" class="btn btn-secondary">{t.hero.knopSite}</a>
        </div>
      </div>
      <div class="apparaten">
        <figure class="browser screen">
          <div class="browser-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="url">{kaalAdres(APP.site)}</span>
          </div>
          <picture>
            <source srcset={beeld("/beeld/jonabestuur-vergadermodus.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/jonabestuur-vergadermodus.png", taal)} width="1600" height="1000" alt={t.hero.altBrowser}>
          </picture>
        </figure>
        <div class="telefoon">
          <picture>
            <source srcset={beeld("/beeld/jonabestuur-mobiel-punt.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/jonabestuur-mobiel-punt.png", taal)} width="780" height="1688" alt={t.hero.altTelefoon}>
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section-mist stappen-sectie">
    <div class="wrap stack gap-40">
      <div class="narrow stack gap-12">
        <p class="eyebrow">{t.stappen.eyebrow}</p>
        <h2 class="h2">{t.stappen.kop}</h2>
      </div>
      <ol class="tijdlijn">
        {t.stappen.lijst.map((s, i) => (
          <li>
            <div class="bol"><Icon name={s.icon} size={22} /></div>
            <p class="eyebrow">{t.stappen.stap} {i + 1}</p>
            <h3>{s.titel}</h3>
            <p class="muted">{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bijzonder">
    <div class="wrap stack gap-80">

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">{t.vergadermodus.eyebrow}</p>
          <h2 class="h2-sm">{t.vergadermodus.kop}</h2>
          <p class="muted f-tekst">{t.vergadermodus.tekst}</p>
        </div>
        <ul class="vragen">
          {t.vergadermodus.vragen.map((v) => (
            <li>
              <p class="eyebrow">{v.label}</p>
              <p class="vraag-kop">{v.vraag}</p>
              <p class="muted">{v.tekst}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="feature omgekeerd">
        <figure class="screen">
          <picture>
            <source srcset={beeld("/beeld/jonabestuur-notulen.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/jonabestuur-notulen.png", taal)} width="1600" height="1000" loading="lazy" alt={t.notulen.alt}>
          </picture>
        </figure>
        <div class="stack gap-16">
          <p class="eyebrow">{t.notulen.eyebrow}</p>
          <h2 class="h2-sm">{t.notulen.kop}</h2>
          <p class="muted f-tekst">{t.notulen.tekst}</p>
        </div>
      </div>

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">{t.besluiten.eyebrow}</p>
          <h2 class="h2-sm">{t.besluiten.kop}</h2>
          <p class="muted f-tekst">{t.besluiten.tekst}</p>
        </div>
        <figure class="screen">
          <picture>
            <source srcset={beeld("/beeld/jonabestuur-besluiten.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/jonabestuur-besluiten.png", taal)} width="1600" height="1000" loading="lazy" alt={t.besluiten.alt}>
          </picture>
        </figure>
      </div>

      <div class="feature omgekeerd">
        <div class="illu">
          <div class="telefoon">
            <picture>
              <source srcset={beeld("/beeld/jonabestuur-mobiel-agenda.webp", taal)} type="image/webp">
              <img src={beeld("/beeld/jonabestuur-mobiel-agenda.png", taal)} width="780" height="1688" loading="lazy" alt={t.telefoon.altAgenda}>
            </picture>
          </div>
          <div class="telefoon laag">
            <picture>
              <source srcset={beeld("/beeld/jonabestuur-mobiel-besluiten.webp", taal)} type="image/webp">
              <img src={beeld("/beeld/jonabestuur-mobiel-besluiten.png", taal)} width="780" height="1688" loading="lazy" alt={t.telefoon.altBesluiten}>
            </picture>
          </div>
        </div>
        <div class="stack gap-16">
          <p class="eyebrow">{t.telefoon.eyebrow}</p>
          <h2 class="h2-sm">{t.telefoon.kop}</h2>
          <p class="muted f-tekst">{t.telefoon.tekst}</p>
        </div>
      </div>

      <div class="stack gap-32">
        <div class="narrow stack gap-12">
          <p class="eyebrow">{t.meer.eyebrow}</p>
          <h2 class="h2-sm">{t.meer.kop}</h2>
        </div>
        <ul class="meer">
          {t.meer.lijst.map((m) => (
            <li class="card">
              <span class="ico"><Icon name={m.icon} size={20} /></span>
              <h3>{m.titel}</h3>
              <p class="muted">{m.tekst}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="card veilig">
        <div class="stack gap-12 veilig-tekst">
          <span class="ico"><Icon name="shield-check" size={20} /></span>
          <h2 class="h2-sm">{t.veilig.kop}</h2>
          <p class="muted">{t.veilig.tekst}</p>
        </div>
        <ul class="checks veilig-lijst">
          {t.veilig.lijst.map((v) => (
            <li><Icon name="check" /><span>{v}</span></li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <section id="proberen" class="section section-mist">
    <div class="wrap grid">
      <div class="stack gap-28">
        <div class="stack gap-12">
          <p class="eyebrow">{t.prijs.eyebrow}</p>
          <h2 class="h2">{t.prijs.kop}</h2>
          <p class="muted f-tekst">{t.prijs.tekst}</p>
        </div>
        <div class="card persoonlijk">
          <picture>
            <source srcset={beeld("/beeld/jonagiften-ruben.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/jonagiften-ruben.png", taal)} width="900" height="816" loading="lazy" alt={t.prijs.portretAlt}>
          </picture>
          <div class="stack gap-6">
            <p>{t.prijs.persoonlijk}</p>
            <p class="muted p-naam">{t.prijs.naam}</p>
            <div class="contact"><a href="tel:+31332301737">{t.prijs.telefoon}</a><a href="mailto:ruben@jonacommunicatie.nl">ruben@jonacommunicatie.nl</a></div>
          </div>
        </div>
      </div>

      <div class="card prijskaart">
        <h3 class="h3 h3-22">{t.prijs.kaartKop}</h3>
        <div class="opties">
          <div class="optie uitgelicht">
            <span class="wat">{t.prijs.perJaarBetalen}</span>
            <span class="hoeveel">{bedrag(taal, 9.95)} <small>{t.prijs.perMaand}</small></span>
            <span class="extra">{bedrag(taal, 119.4, 2)} {t.prijs.perJaar}</span>
          </div>
          <div class="optie">
            <span class="wat">{t.prijs.perMaandBetalen}</span>
            <span class="hoeveel">{bedrag(taal, 12.95)} <small>{t.prijs.perMaand}</small></span>
            <span class="extra muted">{t.prijs.perMaandAfgerekend}</span>
          </div>
        </div>
        <ul class="checks">
          {t.prijs.checks.map((c) => (
            <li><Icon name="check" /><span>{c}</span></li>
          ))}
        </ul>
        <a href={AANMELDEN} rel="noopener" class="btn btn-primary btn-52"><span>{t.prijs.knop}</span> <Icon name="arrow-right" /></a>
        <p class="note">{t.prijs.note[0]}<a href={APP.site} rel="noopener">{kaalAdres(APP.site)}</a>{t.prijs.note[1]}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow stack gap-32">
      <h2 class="faq-kop">{t.faq.kop}</h2>
      <div class="faq">
        {t.faq.lijst.map((f) => (
          <div class="vraag stack gap-6">
            <h3>{f.v}</h3>
            <p class="muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 96px 0 72px; overflow: hidden; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 4px; }

  /* laptop met telefoon ervoor */
  .apparaten { position: relative; padding-right: 9%; padding-bottom: 40px; }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--mist);
  }
  .dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: var(--border); }
  .url {
    margin-left: 12px;
    flex: 1;
    min-height: 28px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 13px;
    color: var(--muted);
  }
  .telefoon {
    background: var(--navy-900);
    padding: 9px;
    border-radius: 38px;
    box-shadow: 0 30px 60px -20px rgba(4, 32, 47, 0.45);
  }
  .telefoon img { display: block; width: 100%; height: auto; border-radius: 30px; }
  .apparaten .telefoon { position: absolute; right: 0; bottom: 0; width: 23%; min-width: 150px; }

  /* tijdlijn */
  .stappen-sectie { padding: 80px 0; }
  .tijdlijn {
    list-style: none;
    padding: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .tijdlijn::before {
    content: "";
    position: absolute;
    left: 28px;
    right: calc(25% + 28px);
    top: 28px;
    height: 2px;
    background: var(--teal);
    opacity: 0.45;
  }
  .tijdlijn li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-right: 24px;
  }
  .tijdlijn h3 { font-size: 20px; font-weight: 500; line-height: 1.3; }
  .tijdlijn p.muted { font-size: 16px; }
  .bol {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 2px solid var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal-700);
    box-shadow: 0 0 0 6px var(--mist);
  }

  /* uitgelichte functies */
  .bijzonder { padding: 88px 0 72px; }
  .gap-80 { gap: 80px; }
  .gap-32 { gap: 32px; }
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: center;
  }
  .feature > * { min-width: 0; }
  .f-tekst { font-size: 18px; }
  .illu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 360px;
  }
  .illu .telefoon { width: 200px; }
  .illu .telefoon.laag { margin-top: 70px; }
  .pijl { color: var(--teal); flex-shrink: 0; }
  .melding {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-small);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    width: 220px;
  }
  .m-kop { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; }
  .m-regel { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .m-bedrag { font-family: var(--font-serif); font-size: 22px; }
  .m-ideal {
    padding: 1px 8px;
    border-radius: var(--r-pill);
    background: var(--teal-100);
    color: var(--teal-800);
    font-size: 11px;
    font-weight: 500;
  }

  /* en meer */
  .meer {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .meer li { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .ico {
    width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    background: var(--teal-100);
    color: var(--teal-800);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .meer h3 { font-size: 18px; font-weight: 500; line-height: 1.3; }
  .meer p { font-size: 15.5px; }

  /* prijs */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: start;
  }
  .grid > * { min-width: 0; }
  .h3-22 { font-size: 22px; }
  .prijskaart { padding: 32px; box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 22px; }
  .opties { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .optie { border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
  .optie.uitgelicht { border-color: var(--teal); background: var(--teal-100); }
  .wat { font-size: 13px; color: var(--muted); }
  .hoeveel { font-family: var(--font-serif); font-size: 30px; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .hoeveel small { font-family: var(--font-sans); font-size: 14px; color: var(--muted); }
  .extra { font-size: 13px; color: var(--teal-800); }
  .extra.muted { color: var(--muted); }
  .btn-52 { min-height: 52px; }
  .note { font-size: 13px; color: var(--muted); }
  .persoonlijk { padding: 24px; display: flex; gap: 20px; align-items: center; }
  .persoonlijk img {
    display: block;
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: var(--r-pill);
    background: var(--mist);
    flex-shrink: 0;
  }
  .p-naam { font-size: 15px; }
  .contact { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 15px; }

  /* faq */
  .faq-kop {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 31px;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--teal-700);
  }
  .faq { display: flex; flex-direction: column; }
  .vraag { padding: 24px 0; border-top: 1px solid var(--border); }
  .vraag:last-child { border-bottom: 1px solid var(--border); }
  .vraag h3 { font-size: 19px; font-weight: 500; }

  /* drie vragen per agendapunt */
  .vragen { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .vragen li {
    background: var(--white);
    border: 2px dashed var(--teal-300);
    border-radius: var(--r-card);
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .vraag-kop { font-family: var(--font-serif); font-weight: 500; font-size: 21px; line-height: 1.3; }

  /* veilig */
  .veilig {
    padding: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 56px;
    align-items: start;
    background: var(--mist);
  }
  .veilig > * { min-width: 0; }

  @media (max-width: 1023px) {
    .tijdlijn { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; }
    .tijdlijn::before { display: none; }
    .meer { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .hero { padding: 64px 0 48px; }
    .stappen-sectie { padding: 64px 0; }
    .bijzonder { padding: 64px 0 40px; }
    .gap-80 { gap: 56px; }
    .feature { gap: 28px; }
    .omgekeerd .illu, .omgekeerd > .screen { order: 1; }
    .illu { min-height: 0; }
    .illu .telefoon { width: 46%; max-width: 200px; }
    .illu .telefoon.laag { margin-top: 40px; }
    .prijskaart { padding: 24px 20px; }
    .veilig { padding: 28px 22px; }
  }
  @media (max-width: 560px) {
    .tijdlijn { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .tijdlijn::before {
      display: block;
      left: 27px;
      right: auto;
      top: 28px;
      bottom: 28px;
      width: 2px;
      height: auto;
    }
    .tijdlijn li { padding: 0 0 36px 76px; }
    .tijdlijn li:last-child { padding-bottom: 0; }
    .tijdlijn .bol { position: absolute; left: 0; top: 0; }
    .meer { grid-template-columns: minmax(0, 1fr); }
    .opties { grid-template-columns: minmax(0, 1fr); }
    .apparaten { padding-right: 0; padding-bottom: 0; }
    .apparaten .telefoon { position: relative; width: 52%; min-width: 0; margin: -60px 0 0 auto; }
    .met-melding { flex-direction: column; }
    .met-melding .pijl { transform: rotate(90deg); }
    .persoonlijk { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 479px) {
    .actions .btn { width: 100%; }
  }
</style>
