---
// Over Jona, één opmaak voor alle talen. De teksten staan in
// src/teksten/over-jona/<taal>.ts; de routes in src/pages/<taal>/ (nl/over-jona,
// en/about, de/ueber-uns).
import { link, pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import LetsTalk from "../components/LetsTalk.astro";
import FormScript from "../components/FormScript.astro";
import type { Taal } from "../i18n/talen";
import { nl } from "../teksten/over-jona/nl";
import { en } from "../teksten/over-jona/en";
import { de } from "../teksten/over-jona/de";

interface Props { taal: Taal }
const { taal } = Astro.props;
const t = { nl, en, de }[taal];
const team = t.wie.team;
---
<Base
  {...pagina(link("over-jona", taal))}
  current="over-jona"
>
  <section class="hero">
    <div class="wrap narrow stack gap-24">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="h1 h1-sm">{t.hero.kop}</h1>
      <p class="lead">{t.hero.lead}</p>
    </div>
  </section>

  <section class="waarom-doen">
    <div class="wrap narrow stack gap-48">
      <div class="rule"></div>
      <div class="stack gap-16">
        <h2 class="h2 h2-32">{t.waaromDoen.kop}</h2>
        {t.waaromDoen.alineas.map((a) => <p class="tekst">{a}</p>)}
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="wrap stack gap-48">
      <div class="narrow stack gap-12">
        <p class="eyebrow">{t.wie.eyebrow}</p>
        <h2 class="h2">{t.wie.kop}</h2>
        <p class="intro muted">{t.wie.intro}</p>
      </div>
      <div class="team">
        {team.map((p) => (
          <div class="lid stack gap-16">
            <div class="foto">
              <picture>
                <source srcset={`/beeld/${p.beeld}.webp`} type="image/webp">
                <img src={`/beeld/${p.beeld}.png`} width={p.b} height={p.h} loading="lazy" alt={`${t.wie.portret} ${p.naam}`}>
              </picture>
            </div>
            <div class="stack gap-6">
              <p class="eyebrow">{p.rol}</p>
              <h3 class="h3">{p.naam}</h3>
              <p class="lid-tekst muted">{p.tekst}</p>
              <a href={`mailto:${p.mail}`} class="link mail">{p.mail}</a>
            </div>
          </div>
        ))}
      </div>
      <p class="bellen">{t.wie.bellen} <a href="tel:+31332301737" class="link">{t.wie.telefoon}</a></p>
    </div>
  </section>

  <section id="waarom-jona" class="waarom-jona">
    <div class="wrap grid">
      <div class="stack gap-20">
        <p class="eyebrow">{t.waaromJona.eyebrow}</p>
        <h2 class="h2">{t.waaromJona.kop}</h2>
        {t.waaromJona.alineas.map((a) => <p class="tekst-lg">{a}</p>)}
        <p class="tekst-lg"><em>{t.waaromJona.slot}</em></p>
      </div>
      <div class="duif">
        <img src="/logo/jona-mark.svg" alt={t.waaromJona.duifAlt} width="232" height="232">
      </div>
    </div>
  </section>

  <LetsTalk id="advies" />
  <FormScript />
</Base>

<style>
  .hero { padding: 112px 0 64px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .waarom-doen { padding: 0 0 96px; }
  .rule { height: 1px; background: var(--border); }
  .h2-32 { font-size: 32px; }
  .tekst { font-size: 19px; line-height: 1.65; }
  .intro { font-size: 18px; }
  .team {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  /* gelijke hoogte per kolom, de tekening tegen de onderrand, geen achtergrond */
  .foto { position: relative; aspect-ratio: 10 / 9; }
  .foto picture { position: absolute; inset: 0; display: block; }
  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  .lid-tekst { font-size: 16px; }
  .mail { font-size: 15px; align-self: flex-start; margin-top: 4px; }
  .bellen {
    font-size: 19px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .bellen .link { font-size: 19px; }
  .waarom-jona { padding: 112px 0 96px; scroll-margin-top: 24px; }
  .waarom-jona .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }
  .tekst-lg { font-size: 19px; line-height: 1.6; }
  .duif {
    position: sticky;
    top: 120px;
    display: flex;
    justify-content: center;
    padding-top: 64px;
  }
  .duif img { width: 260px; height: auto; }

  @media (max-width: 1023px) {
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .hero { padding: 72px 0 48px; }
    .waarom-doen { padding-bottom: 64px; }
    .waarom-jona { padding: 64px 0; }
    .waarom-jona .grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .duif { position: static; padding-top: 0; order: -1; justify-content: flex-start; }
    .duif img { width: 160px; }
  }
  @media (max-width: 479px) {
    .team { grid-template-columns: minmax(0, 1fr); }
  }
</style>
