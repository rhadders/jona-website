---
// De pagina Selaread, één opmaak voor alle talen. De teksten staan in
// src/teksten/selaread/<taal>.ts; de routes in src/pages/<taal>/selaread.astro.
import { BEDANKT, link, pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FormScript from "../components/FormScript.astro";
import type { Taal } from "../i18n/talen";
import { nl } from "../teksten/selaread/nl";
import { en } from "../teksten/selaread/en";
import { de } from "../teksten/selaread/de";

interface Props { taal: Taal }
const { taal } = Astro.props;
const t = { nl, en, de }[taal];
const pro = t.pro.functies;
import { beeld } from "../i18n/beelden";
---
<Base
  {...pagina(link("selaread", taal))}
  current="software"
>
  <section class="hero">
    <div class="wrap stack gap-56">
      <nav aria-label={t.kruimelpad} class="crumbs">
        <a href={link("software", taal)}>{t.kruimelSoftware}</a>
        <Icon name="chevron-right" size={14} />
        <span>Selaread</span>
      </nav>
      <div class="hero-grid">
        <div class="stack gap-24 hero-tekst">
          <span class="tag">{t.hero.tag}</span>
          <h1 class="h1 h1-sm"><img src={beeld("/beeld/selaread-logo.png", taal)} srcset={beeld("/beeld/selaread-logo.webp", taal)} width="240" height="242" alt="" class="merk">Selaread: {t.hero.kop}</h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="actions">
            <a href="#beta" class="btn btn-primary"><span>{t.hero.knopBeta}</span> <Icon name="arrow-right" /></a>
            <a href="#uitgevers" class="btn btn-secondary">{t.hero.knopUitgevers}</a>
          </div>
        </div>
        <picture class="hero-beeld">
          <source srcset={beeld("/beeld/selaread-apparaten.webp", taal)} type="image/webp">
          <img src={beeld("/beeld/selaread-apparaten.png", taal)} width="1400" height="1639" alt={t.hero.alt} fetchpriority="high">
        </picture>
      </div>
    </div>
  </section>

  <section class="section-mist lezers">
    <div class="wrap stack gap-40">
      <div class="narrow stack gap-12">
        <p class="eyebrow">{t.lezers.eyebrow}</p>
        <h2 class="h2">{t.lezers.kop}</h2>
        <p class="lead-sm muted">{t.lezers.lead}</p>
      </div>
      <ul class="grid-3 kaarten">
        {t.lezers.kaarten.map((k) => (
          <li class="card kaart stack gap-12">
            <div class="bol"><Icon name={k.icon} size={22} /></div>
            <h3>{k.titel}</h3>
            <p class="muted">{k.tekst}</p>
          </li>
        ))}
      </ul>
      <figure class="browser screen">
        <div class="browser-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="url">selaread.app/explore</span>
        </div>
        <picture>
          <source srcset={beeld("/beeld/selaread-ontdek.webp", taal)} type="image/webp">
          <img src={beeld("/beeld/selaread-ontdek.png", taal)} width="1800" height="1177" loading="lazy" alt={t.lezers.alt}>
        </picture>
      </figure>
    </div>
  </section>

  <section id="uitgevers" class="uitgevers">
    <div class="wrap stack gap-48">
      <div class="narrow stack gap-12">
        <p class="eyebrow">{t.uitgevers.eyebrow}</p>
        <h2 class="h2">{t.uitgevers.kop}</h2>
        <p class="lead-sm muted">{t.uitgevers.lead}</p>
      </div>

      <div class="grid-2 start kaarten">
        {t.uitgevers.kaarten.map((k) => (
          <article class="card kaart kaart-groot stack gap-12">
            <div class="bol"><Icon name={k.icon} size={22} /></div>
            <h3>{k.titel}</h3>
            <p class="muted">{k.tekst}</p>
          </article>
        ))}
      </div>

      <div class="band">
        <p class="band-cijfer"><span class="groot">{t.uitgevers.bandCijfer}</span><span class="band-sub">{t.uitgevers.bandSub}</span></p>
        <div class="stack gap-8">
          <h3 class="band-kop">{t.uitgevers.bandKop}</h3>
          <p class="muted">{t.uitgevers.bandTekst}</p>
        </div>
      </div>

      <div class="stack gap-24">
        <h3 class="h3 h3-22">{t.uitgevers.zoKop}</h3>
        <ol class="stappen">
          {t.uitgevers.stappen.map((s, i) => (
            <li class="stack gap-8">
              <span class="num">{i + 1}</span>
              <h4>{s.titel}</h4>
              <p class="muted">{s.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-mist pro-sectie">
    <div class="wrap stack gap-40">
      <div class="pro-kop">
        <div class="stack gap-12">
          <p class="eyebrow">{t.pro.eyebrow}</p>
          <h2 class="h2">{t.pro.kop}</h2>
        </div>
        <p class="lead-sm muted">{t.pro.lead}</p>
      </div>

      <div class="pro-kaart">
        <figure class="pro-beeld">
          <picture>
            <source srcset={beeld("/beeld/selaread-uitgeversportaal.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/selaread-uitgeversportaal.png", taal)} width="998" height="648" loading="lazy" alt={t.pro.alt}>
          </picture>
        </figure>
        <div class="pro-slider" data-slider>
          <p class="eyebrow pro-teller">{t.pro.teller} <span data-nummer>1</span> {t.pro.van} {pro.length}</p>
          <div class="functies" aria-live="polite">
            {pro.map((p, i) => (
              <article class="functie" data-functie={i}>
                <div class="bol bol-groot"><Icon name={p.icon} size={24} /></div>
                <h3>{p.titel}</h3>
                <p class="muted">{p.tekst}</p>
              </article>
            ))}
          </div>
          <div class="pro-nav">
            <div class="pijlen">
              <button type="button" class="pijl" data-vorige aria-label={t.pro.vorige}><Icon name="chevron-left" /></button>
              <button type="button" class="pijl" data-volgende aria-label={t.pro.volgende}><Icon name="chevron-right" /></button>
            </div>
            <div class="dots">
              {pro.map((p, i) => (
                <button type="button" class="dot" data-naar={i} aria-label={`${t.pro.functie} ${i + 1}: ${p.titel}`}></button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="prijsbalk">
        <span class="prijs-naam">{t.pro.prijsNaam}</span>
        <span class="prijs-scheiding" aria-hidden="true"></span>
        <p class="prijs"><span class="prijs-bedrag">{t.pro.prijsBedrag}</span><span class="prijs-per">{t.pro.prijsPer}</span></p>
        <span class="muted prijs-noot">{t.pro.prijsNoot}</span>
        <a href="#beta" class="btn btn-primary"><span>{t.pro.knop}</span> <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="faq-sectie">
    <div class="wrap narrow stack gap-28">
      <h2 class="faq-kop">{t.faqKop}</h2>
      <div class="faq">
        {t.faq.map((f) => (
          <div class="vraag stack gap-6">
            <h3>{f.v}</h3>
            <p class="muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="beta" class="beta">
    <div class="wrap">
      <div class="kaart-navy on-navy">
        <img src={beeld("/beeld/selaread-logo.png", taal)} alt="" aria-hidden="true" class="watermark" width="240" height="242">
        <div class="stack gap-16 kaart-tekst">
          <p class="eyebrow">{t.beta.eyebrow}</p>
          <h2 class="kaart-kop">{t.beta.kop}</h2>
          <p class="kaart-lead">{t.beta.lead}</p>
          <ul class="checks checks-navy">
            {t.beta.punten.map((p) => (
              <li><Icon name="check" size={16} /><span>{p}</span></li>
            ))}
          </ul>
        </div>
        <form id="aanvraag" class="form kaart-form" method="post" action="/api/beta-selaread" data-form="beta-selaread" data-bedankt={BEDANKT[taal]} novalidate>
          <input type="hidden" name="_bron" value="">
          <input type="hidden" name="_taal" value={taal}>
          <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="field">
            <label for="sr-rol">{t.form.rol}</label>
            <select id="sr-rol" name="rol">
              {t.form.rolOpties.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="row">
            <div class="field">
              <label for="sr-naam">{t.form.naam}</label>
              <input id="sr-naam" name="naam" type="text" autocomplete="name" required>
              <span class="err" data-error-for="naam"></span>
            </div>
            <div class="field">
              <label for="sr-email">{t.form.email}</label>
              <input id="sr-email" name="email" type="email" autocomplete="email" required>
              <span class="err" data-error-for="email"></span>
            </div>
          </div>
          <div class="field">
            <label for="sr-organisatie">{t.form.organisatie} <span class="optioneel">{t.form.optioneel}</span></label>
            <input id="sr-organisatie" name="organisatie" type="text" autocomplete="organization">
          </div>
          <p class="form-status" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-accent btn-block btn-52">{t.form.knop} <Icon name="arrow-right" /></button>
          <p class="note">{t.form.noot} <a href="mailto:ruben@selaread.app">ruben@selaread.app</a>.</p>
        </form>
      </div>
    </div>
  </section>

  <FormScript />
</Base>

<script>
  // De functieslider van Selaread Pro: zonder JavaScript staan de vijf functies onder elkaar.
  for (const slider of document.querySelectorAll<HTMLElement>("[data-slider]")) {
    const functies = [...slider.querySelectorAll<HTMLElement>("[data-functie]")];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>("[data-naar]")];
    const nummer = slider.querySelector<HTMLElement>("[data-nummer]");
    if (functies.length < 2) continue;
    let i = 0;
    const toon = (n: number) => {
      i = (n + functies.length) % functies.length;
      functies.forEach((f, k) => f.classList.toggle("actief", k === i));
      dots.forEach((d, k) => d.setAttribute("aria-current", k === i ? "true" : "false"));
      if (nummer) nummer.textContent = String(i + 1);
    };
    slider.querySelector("[data-vorige]")?.addEventListener("click", () => toon(i - 1));
    slider.querySelector("[data-volgende]")?.addEventListener("click", () => toon(i + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => toon(k)));
    slider.classList.add("js");
    toon(0);
  }
</script>

<style>
  .hero { padding: 96px 0 72px; }
  .h1-sm { font-size: clamp(34px, 4.6vw, 50px); }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 4px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: center;
  }
  .hero-tekst { max-width: 58ch; }
  .merk {
    display: block;
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
  }
  .hero-beeld { display: block; margin: 0; }
  .hero-beeld img { width: 100%; height: auto; max-width: 520px; margin-left: auto; display: block; }

  .lead-sm { font-size: 18px; }
  .lezers { padding: 80px 0; }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--mist);
  }
  .dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: var(--border); }
  .url {
    margin-left: 8px;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
  }

  .kaarten { list-style: none; margin: 0; padding: 0; }
  .kaart { padding: 28px; }
  .kaart h3 { font-size: 20px; font-weight: 500; line-height: 1.3; }
  .kaart p { font-size: 16px; }
  .kaart-groot { padding: 32px; }
  .kaart-groot h3 { font-size: 22px; }
  .kaart-groot p { font-size: 17px; }
  .bol {
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    display: grid;
    place-items: center;
    background: var(--teal-100);
    color: var(--teal-800);
    margin-bottom: 4px;
  }

  .uitgevers { padding: 96px 0; }
  .gap-48 { gap: 48px; }
  .gap-8 { gap: 8px; }
  .band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 36px 40px;
    border-radius: var(--r-card);
    background: var(--teal-100);
  }
  .band-cijfer { display: flex; flex-direction: column; gap: 4px; min-width: 200px; }
  .groot {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 72px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--teal-800);
  }
  .band-sub { font-size: 14px; color: var(--teal-800); max-width: 18ch; }
  .band-kop { font-size: 22px; font-weight: 500; line-height: 1.3; }
  .band p { font-size: 17px; }
  .h3-22 { font-size: 22px; }
  .stappen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .stappen h4 { font-size: 18px; font-weight: 500; line-height: 1.3; }
  .stappen p { font-size: 16px; }
  .num {
    width: 36px;
    height: 36px;
    border-radius: var(--r-pill);
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--white);
    font-weight: 500;
    font-size: 15px;
    margin-bottom: 6px;
  }

  .pro-sectie { padding: 96px 0; }
  .pro-kop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px 64px;
    align-items: end;
  }
  .pro-kop .lead-sm { max-width: 52ch; }
  .pro-kaart {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 28px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .pro-beeld {
    margin: 0;
    padding: 48px 0 0 48px;
    background: var(--teal-100);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .pro-beeld img {
    width: 112%;
    max-width: none;
    height: auto;
    display: block;
    margin-bottom: -4%;
    filter: drop-shadow(0 24px 40px color-mix(in srgb, var(--navy-900) 18%, transparent));
  }
  .pro-slider {
    padding: 48px 44px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pro-teller { color: var(--teal-700); }
  .functies { display: flex; flex-direction: column; gap: 32px; flex-grow: 1; }
  .functie { display: flex; flex-direction: column; gap: 14px; }
  .functie h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .functie p { font-size: 17px; max-width: 40ch; }
  .bol-groot { width: 56px; height: 56px; margin-bottom: 0; }
  .bol-groot svg { color: var(--teal-700); }
  /* met JavaScript: één functie tegelijk, met pijlen en bolletjes */
  .pro-slider.js .functies { min-height: 300px; }
  .pro-slider.js .functie:not(.actief) { display: none; }
  .pro-nav { display: none; align-items: center; justify-content: space-between; gap: 16px; }
  .pro-slider.js .pro-nav { display: flex; }
  .pijlen, .dots { display: flex; gap: 8px; }
  .pijl {
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--navy);
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
    transition: border-color 140ms ease-out;
  }
  .pijl:hover { border-color: var(--teal-300); }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    border: 0;
    padding: 0;
    background: var(--border);
    cursor: pointer;
    transition: width 220ms ease-out, background 220ms ease-out;
  }
  .dot[aria-current="true"] { width: 24px; background: var(--navy); }
  .prijsbalk {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px 28px;
    padding: 20px 20px 20px 32px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
  }
  .prijs-naam { font-size: 20px; font-weight: 500; }
  .prijs-scheiding { width: 1px; height: 32px; background: var(--border); }
  .prijs { display: flex; align-items: baseline; gap: 8px; }
  .prijs-bedrag {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 31px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .prijs-per, .prijs-noot { font-size: 16px; }
  .prijsbalk .btn { margin-left: auto; }

  .faq-sectie { padding: 96px 0 0; }
  .faq-kop {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 31px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .faq { display: flex; flex-direction: column; }
  .vraag { padding: 24px 0; border-top: 1px solid var(--border); }
  .vraag:last-child { border-bottom: 1px solid var(--border); }
  .vraag h3 { font-size: 19px; font-weight: 500; }

  .beta { padding: 96px 0; }
  .kaart-navy {
    position: relative;
    overflow: hidden;
    background: var(--navy-800);
    border-radius: 28px;
    padding: 56px 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 48px;
    align-items: center;
  }
  .watermark {
    position: absolute;
    bottom: -120px;
    right: -90px;
    width: 400px;
    height: 400px;
    opacity: 0.08;
    filter: brightness(0) invert(1);
    pointer-events: none;
  }
  .kaart-tekst, .kaart-form { position: relative; }
  .kaart-tekst { max-width: 48ch; }
  .kaart-kop {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .kaart-lead { font-size: 18px; color: var(--ink-on-navy); }
  .checks-navy { font-size: 16px; }
  .checks-navy svg { color: var(--teal-300); stroke-width: 2.2; }
  .optioneel { font-weight: 400; opacity: 0.75; }
  .btn-52 { min-height: 52px; }
  .err { font-size: 13px; color: var(--warn-ink); }
  .err:empty { display: none; }

  @media (max-width: 1023px) {
    .hero-grid { gap: 32px; }
    .stappen { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pro-kop { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .pro-kaart { grid-template-columns: minmax(0, 1fr); }
    .pro-beeld { padding: 40px 40px 0; }
    .pro-beeld img { width: 100%; margin-bottom: -3%; }
    .pro-slider.js .functies { min-height: 0; }
    .prijs-scheiding { display: none; }
  }
  @media (max-width: 767px) {
    .hero { padding: 64px 0 48px; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero-beeld img { max-width: 340px; margin: 0 auto; }
    .lezers, .pro-sectie { padding: 64px 0; }
    .uitgevers, .beta { padding: 64px 0; }
    .faq-sectie { padding: 64px 0 0; }
    .kaart, .kaart-groot { padding: 24px; }
    .band { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 28px 24px; }
    .groot { font-size: 56px; }
    .stappen { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .pro-beeld { padding: 24px 24px 0; }
    .pro-slider { padding: 28px 24px; gap: 24px; }
    .functie h3 { font-size: 24px; }
    .prijsbalk { padding: 20px 24px; gap: 12px 20px; }
    .prijsbalk .btn { margin-left: 0; width: 100%; justify-content: center; }
    .kaart-navy { padding: 36px 24px; gap: 32px; }
    .kaart-kop { font-size: 27px; }
    .watermark { width: 260px; height: 260px; bottom: -80px; right: -60px; }
  }
  @media (max-width: 479px) {
    .kaart-navy { grid-template-columns: minmax(0, 1fr); }
    .actions .btn { width: 100%; justify-content: center; }
  }
</style>
