---
// TirgumAI, één opmaak voor alle talen. De teksten staan in
// src/teksten/tirgumai/<taal>.ts; de routes in src/pages/<taal>/tirgumai.astro.
import { BEDANKT, link, pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FormScript from "../components/FormScript.astro";
import type { Taal } from "../i18n/talen";
import { nl } from "../teksten/tirgumai/nl";
import { en } from "../teksten/tirgumai/en";
import { de } from "../teksten/tirgumai/de";

interface Props { taal: Taal }
const { taal } = Astro.props;
const t = { nl, en, de }[taal];
const d = t.drukwerk;
import { beeld } from "../i18n/beelden";
---
<Base
  {...pagina(link("tirgumai", taal))}
  current="software"
>
  <section class="hero">
    <div class="wrap stack gap-56">
      <nav aria-label={t.kruimelpad} class="crumbs">
        <a href={link("software", taal)}>{t.software}</a>
        <Icon name="chevron-right" size={14} />
        <span>TirgumAI</span>
      </nav>
      <div class="narrow stack gap-24">
        <span class="tag">{t.hero.tag}</span>
        <h1 class="h1 h1-sm">{t.hero.kop}</h1>
        <p class="lead" set:html={t.hero.leadHtml} />
        <div class="actions">
          <a href="#op-de-hoogte" class="btn btn-primary"><span>{t.hero.knopHoogte}</span> <Icon name="arrow-right" /></a>
          <a href="#leessite" class="btn btn-secondary">{t.hero.knopLeessite}</a>
        </div>
      </div>

      <figure class="browser screen vergelijk" data-vergelijk>
        <div class="browser-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="url">app.tirgumai.nl</span>
        </div>
        <div class="beeld">
          <picture>
            <source srcset={beeld("/beeld/tirgumai-werkplek-licht.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/tirgumai-werkplek-licht.png", taal)} width="1800" height="1181" alt={t.vergelijk.alt}>
          </picture>
          <picture class="donker" aria-hidden="true">
            <source srcset={beeld("/beeld/tirgumai-werkplek-donker.webp", taal)} type="image/webp">
            <img src={beeld("/beeld/tirgumai-werkplek-donker.png", taal)} width="1800" height="1181" alt="" loading="lazy">
          </picture>
          <span class="modus links" aria-hidden="true">{t.vergelijk.licht}</span>
          <span class="modus rechts" aria-hidden="true">{t.vergelijk.donker}</span>
          <div class="lijn" aria-hidden="true"></div>
          <div class="greep" aria-hidden="true"><Icon name="chevrons-left-right" size={20} /></div>
          <input type="range" class="schuif" min="0" max="100" step="0.5" value="50" aria-label={t.vergelijk.schuif}>
        </div>
      </figure>
    </div>
  </section>

  <section class="section-mist functies">
    <div class="wrap stack gap-40">
      <div class="stack gap-12 midden">
        <p class="eyebrow">{t.functies.eyebrow}</p>
        <h2 class="h2" set:html={t.functies.kopHtml} />
      </div>
      <ol class="strook" aria-label={t.functies.strook}>
        <div class="ai-kader" aria-hidden="true"><span class="ai-label"><span><Icon name="sparkles" size={14} /> {t.functies.aiLabel}</span></span></div>
        {t.functies.stappen.map((s, i) => (
          <li class:list={["stap", { ai: s.ai }]} style={`--kolom: ${i + 1}`}>
            <div class="bol"><Icon name={s.icon} size={22} /></div>
            <span>{s.label}</span>
          </li>
        ))}
      </ol>
      <div class="card kolommen">
        {t.functies.groepen.map((g) => (
          <div class="groep stack gap-8">
            <h3 class="eyebrow groep-kop">{g.ai && <Icon name="sparkles" size={14} />}<span>{g.kop}</span></h3>
            <ul class="punten">
              {g.punten.map((p) => <li><Icon name="check" size={16} /><span>{p}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bijzonder">
    <div class="wrap stack gap-96">

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">{t.vertaler.eyebrow}</p>
          <h2 class="h2-sm">{t.vertaler.kop}</h2>
          <p class="muted f-tekst">{t.vertaler.tekst}</p>
        </div>
        <figure class="figuur">
          <div class="screen gevoerd">
            <picture>
              <source srcset={beeld("/beeld/tirgumai-interlineair.webp", taal)} type="image/webp">
              <img src={beeld("/beeld/tirgumai-interlineair.png", taal)} width="1628" height="340" loading="lazy" alt={t.vertaler.alt}>
            </picture>
          </div>
          <figcaption>{t.vertaler.onderschrift}</figcaption>
        </figure>
      </div>

      <div id="leessite" class="feature omgekeerd">
        <figure class="figuur">
          <div class="screen">
            <picture>
              <source srcset={beeld("/beeld/tirgumai-leessite.webp", taal)} type="image/webp">
              <img src={beeld("/beeld/tirgumai-leessite.png", taal)} width="1800" height="1125" loading="lazy" alt={t.lezer.alt}>
            </picture>
          </div>
          <figcaption>{t.lezer.onderschrift}</figcaption>
        </figure>
        <div class="stack gap-16">
          <p class="eyebrow">{t.lezer.eyebrow}</p>
          <h2 class="h2-sm">{t.lezer.kop}</h2>
          <p class="muted f-tekst">{t.lezer.tekst}</p>
        </div>
      </div>

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">{t.team.eyebrow}</p>
          <h2 class="h2-sm">{t.team.kop}</h2>
          <p class="muted f-tekst">{t.team.tekst}</p>
        </div>
        <figure class="figuur">
          <div class="screen">
            <picture>
              <source srcset={beeld("/beeld/tirgumai-consistentie.webp", taal)} type="image/webp">
              <img src={beeld("/beeld/tirgumai-consistentie.png", taal)} width="1800" height="1125" loading="lazy" alt={t.team.alt}>
            </picture>
          </div>
          <figcaption>{t.team.onderschrift}</figcaption>
        </figure>
      </div>

    </div>
  </section>

  <section id="drukwerk" class="drukwerk">
    <div class="wrap stack gap-56">
      <div class="narrow stack gap-16">
        <p class="partners">
          <img src={beeld("/beeld/drukcase-logo.png", taal)} srcset={beeld("/beeld/drukcase-logo.webp", taal)} width="480" height="296" alt="Drukcase" class="partner-drukcase">
          <Icon name="x" size={14} class="partner-kruis" />
          <span class="partner-tirgumai"><img src="/logo/jona-mark.svg" alt="" width="230" height="226">TirgumAI</span>
        </p>
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 class="h2">{d.kop}</h2>
        <p class="muted f-tekst">{d.tekst}</p>
      </div>

      <ul class="voordelen">
        {d.voordelen.map((v) => (
          <li class="stack gap-10">
            <div class="voordeel-kop"><span class="rondje"><Icon name={v.icon} size={18} /></span><h3>{v.kop}</h3></div>
            <p class="muted">{v.tekst}</p>
          </li>
        ))}
      </ul>

      <div class="stack gap-24">
        <div class="card template-groot">
          <div class="template-beeld">
            <picture>
              <source srcset={beeld("/beeld/tirgumai-template-studiebijbel.webp", taal)} type="image/webp">
              <img src={beeld("/beeld/tirgumai-template-studiebijbel.png", taal)} width="2000" height="1500" loading="lazy" alt={d.studiebijbel.alt}>
            </picture>
          </div>
          <div class="stack gap-12">
            <p class="eyebrow">{d.studiebijbel.eyebrow}</p>
            <h3 class="h3 h3-24">{d.studiebijbel.kop}</h3>
            <p class="muted">{d.studiebijbel.tekst}</p>
            <ul class="checks checks-15">
              {d.studiebijbel.punten.map((p) => <li><Icon name="check" size={16} /><span>{p}</span></li>)}
            </ul>
          </div>
        </div>
        <div class="templates">
          {d.templates.map((tp) => (
            <div class="card template stack gap-12">
              <div class="template-beeld staand">
                <picture>
                  <source srcset={beeld(`/beeld/${tp.beeld}.webp`, taal)} type="image/webp">
                  <img src={beeld(`/beeld/${tp.beeld}.png`, taal)} width={tp.b} height={tp.h} loading="lazy" alt={tp.alt}>
                </picture>
              </div>
              <h3 class="h3-19">{tp.naam}</h3>
              <p class="muted template-tekst">{tp.tekst}</p>
            </div>
          ))}
        </div>
        <p class="alle"><span class="muted">{d.alleLabel}</span> {d.alleTemplates.map((n) => <span class="pil">{n}</span>)}</p>
      </div>

      <div class="druk-onder">
        <ol class="drukstappen">
          {d.stappen.map((st, i) => (
            <li class="stack gap-6">
              <div class="drukstap-kop"><span class="num">{i + 1}</span><h3>{st.kop}</h3></div>
              <p class="muted">{st.tekst}</p>
            </li>
          ))}
        </ol>
        <div class="card sheet stack gap-12">
          <p class="eyebrow">{d.sheet.eyebrow}</p>
          <p class="sheet-tekst">{d.sheet.tekst}</p>
          <div class="sheet-links">
            {d.sheet.downloads.map((dl) => <a href={dl.href} class="btn btn-secondary" download hreflang={dl.hreflang}><Icon name="download" size={16} /> {dl.label}</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="op-de-hoogte" class="hoogte">
    <div class="wrap">
      <div class="kaart-navy on-navy">
        <img src="/logo/jona-mark.svg" alt="" aria-hidden="true" class="watermark" width="480" height="480">
        <div class="stack gap-16 kaart-tekst">
          <p class="eyebrow">{t.hoogte.eyebrow}</p>
          <h2 class="kaart-kop">{t.hoogte.kop}</h2>
          <p class="kaart-lead">{t.hoogte.lead}</p>
        </div>
        <form id="aanvraag" class="form kaart-form" method="post" action="/api/nieuwsbrief-tirgumai" data-form="nieuwsbrief-tirgumai" data-bedankt={BEDANKT[taal]} novalidate>
          <ul class="checks checks-navy">
            {t.hoogte.punten.map((p) => <li><Icon name="check" size={16} /><span>{p}</span></li>)}
          </ul>
          <input type="hidden" name="_bron" value="">
          <input type="hidden" name="_taal" value={taal}>
          <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="field">
            <label for="nb-email">{t.hoogte.email}</label>
            <input id="nb-email" name="email" type="email" autocomplete="email" inputmode="email" required>
            <span class="err" data-error-for="email"></span>
          </div>
          <p class="form-status" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-accent btn-block btn-52">{t.hoogte.knop} <Icon name="arrow-right" /></button>
          <p class="note">{t.hoogte.note} <a href="mailto:ruben@jonacommunicatie.nl">ruben@jonacommunicatie.nl</a></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow stack gap-32">
      <h2 class="faq-kop">{t.faq.kop}</h2>
      <div class="faq">
        {t.faq.lijst.map((f) => (
          <div class="vraag stack gap-6">
            <h3>{f.v}</h3>
            <p class="muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FormScript />
</Base>

<script>
  // De schuif tussen de lichte en de donkere modus in het eerste scherm.
  for (const fig of document.querySelectorAll<HTMLElement>("[data-vergelijk]")) {
    const input = fig.querySelector<HTMLInputElement>("input[type=range]");
    if (!input) continue;
    const zet = () => fig.style.setProperty("--pos", `${input.value}%`);
    input.addEventListener("input", zet);
    zet();
  }
</script>

<style>
  .hero { padding: 96px 0 64px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 4px; }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--mist);
  }
  .dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: var(--border); }
  .url {
    margin-left: 12px;
    flex: 1;
    min-height: 28px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 13px;
    color: var(--muted);
  }

  /* licht/donker-schuif */
  .vergelijk { --pos: 50%; margin: 0; }
  .beeld { position: relative; overflow: hidden; background: var(--mist); }
  .beeld picture { display: block; }
  .beeld .donker {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }
  .beeld .donker img { height: 100%; object-fit: cover; }
  .modus {
    position: absolute;
    top: 14px;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .modus.links { left: 14px; background: rgba(255, 255, 255, 0.92); border: 1px solid var(--border); color: var(--navy); }
  .modus.rechts { right: 14px; background: rgba(4, 32, 47, 0.85); border: 1px solid var(--navy-800); color: var(--ink-on-navy); }
  .lijn {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 4px;
    margin-left: -2px;
    background: var(--teal);
    pointer-events: none;
  }
  .greep {
    position: absolute;
    top: 50%;
    left: var(--pos);
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 2px solid var(--teal);
    box-shadow: var(--shadow-small);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal-700);
    pointer-events: none;
  }
  .schuif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .schuif:focus-visible + .greep,
  .beeld:has(.schuif:focus-visible) .greep { box-shadow: 0 0 0 4px rgba(43, 188, 192, 0.35); }

  /* functies */
  .functies { padding: 80px 0; }
  .midden { text-align: center; align-items: center; }
  .midden .eyebrow { text-align: center; }
  .strook {
    list-style: none;
    margin: 44px 0 0;
    padding: 0 40px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .strook::before {
    content: "";
    position: absolute;
    left: calc(8.33% + 40px);
    right: calc(8.33% + 40px);
    top: 28px;
    height: 2px;
    background: var(--teal);
    opacity: 0.45;
  }
  .ai-kader {
    grid-column: 2 / 5;
    grid-row: 1;
    position: relative;
    margin: -44px -12px -14px;
    border: 2px dashed var(--teal);
    border-radius: var(--r-card);
  }
  .ai-label {
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-800);
  }
  .ai-label span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    background: var(--mist);
  }
  .stap {
    position: relative;
    grid-row: 1;
    grid-column: var(--kolom);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
  }
  .bol {
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 2px solid var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal-700);
    box-shadow: 0 0 0 6px var(--mist);
  }
  .stap.ai .bol { background: var(--teal); color: var(--navy-900); }
  .stap.ai .bol svg { stroke-width: 2.2; }
  .kolommen {
    column-count: 2;
    column-gap: 48px;
    padding: 36px 40px 14px;
  }
  .groep { break-inside: avoid; padding-bottom: 22px; }
  .gap-8 { gap: 8px; }
  .groep-kop { display: flex; align-items: center; gap: 8px; font-weight: 500; }
  .punten {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
    line-height: 1.5;
  }
  .punten li { display: flex; gap: 10px; align-items: flex-start; }
  .punten svg { flex-shrink: 0; margin-top: 4px; color: var(--teal-700); stroke-width: 2.2; }

  /* uitgelichte functies */
  .bijzonder { padding: 96px 0; }
  .gap-96 { gap: 96px; }
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: center;
  }
  .f-tekst { font-size: 18px; }
  .figuur { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .figuur figcaption { font-size: 14px; color: var(--muted); }
  .gevoerd { padding: 8px; }
  .gevoerd img { border-radius: 12px; }

  /* drukwerk */
  .drukwerk { padding: 96px 0; border-top: 1px solid var(--border); }
  .partners {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 8px;
  }
  .partner-drukcase { display: block; height: 30px; width: auto; }
  .partner-kruis { color: var(--muted); flex-shrink: 0; }
  .partner-tirgumai {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 19px;
    letter-spacing: -0.015em;
    line-height: 1;
  }
  .partner-tirgumai img { display: block; height: 28px; width: auto; }
  .voordelen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .voordelen p { font-size: 16px; }
  .voordeel-kop { display: flex; align-items: center; gap: 12px; }
  .voordeel-kop h3 { font-size: 19px; font-weight: 500; }
  .rondje {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--r-pill);
    border: 2px solid var(--teal);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--teal-700);
  }
  .template-groot {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 28px;
    background: var(--mist);
  }
  .template-beeld { border-radius: 10px; overflow: hidden; background: var(--white); box-shadow: var(--shadow-small); }
  .template-beeld img { display: block; width: 100%; height: auto; }
  .template-beeld.staand { width: 68%; margin: 0 auto; }
  .h3-24 { font-size: 24px; }
  .h3-19 { font-size: 19px; font-weight: 500; }
  .checks-15 { font-size: 15px; gap: 8px; }
  .checks svg { stroke-width: 2.2; }
  .templates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .template { padding: 24px; background: var(--mist); }
  .template-tekst { font-size: 15px; }
  .alle { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; }
  .pil {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    color: var(--navy);
  }
  .druk-onder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: start;
  }
  .drukstappen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 32px;
  }
  .drukstappen p { font-size: 16px; }
  .drukstap-kop { display: flex; align-items: center; gap: 12px; }
  .drukstap-kop h3 { font-size: 18px; font-weight: 500; }
  .num {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--r-pill);
    background: var(--navy);
    color: var(--white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 500;
  }
  .sheet { padding: 24px; }
