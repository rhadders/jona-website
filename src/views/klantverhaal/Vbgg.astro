---
// Klantverhaal Vakantieweken VBGG, zelfde opzet als HaddersMedia.astro. Eén
// opmaak voor alle talen; de teksten staan in src/teksten/klantverhaal/vbgg/<taal>.ts.
import { link, pagina } from "../../lib/paginas";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LetsTalk from "../../components/LetsTalk.astro";
import FormScript from "../../components/FormScript.astro";
import type { Taal } from "../../i18n/talen";
import { nl } from "../../teksten/klantverhaal/vbgg/nl";
import { en } from "../../teksten/klantverhaal/vbgg/en";

// Geen Duitse versie: in Duitsland bouwt Jona niet in opdracht (MAATWERK in src/i18n/talen.ts).
interface Props { taal: Exclude<Taal, "de"> }
const { taal } = Astro.props;
const t = { nl, en }[taal];
const kort = t.kort.feiten;
const onderdelen = t.gebouwd.onderdelen;
---
<Base
  {...pagina(link("klantverhaal/vbgg", taal))}
>
  <article class="verhaal">
    <section class="kop">
      <div class="wrap narrow stack gap-24">
        <nav aria-label={t.kruimelpad.aria} class="crumbs">
          <a href={link("home", taal, "verhaal")}>{t.kruimelpad.terug}</a>
          <Icon name="chevron-right" size={14} />
          <span>{t.kruimelpad.hier}</span>
        </nav>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="h1 h1-sm">{t.kop}</h1>
        <p class="lead">{t.lead}</p>
      </div>
    </section>

    <section class="beeld">
      <div class="wrap">
        <figure class="stack gap-12">
          <div class="screen">
            <picture>
              <source srcset="/beeld/vbgg-website.webp" type="image/webp">
              <img src="/beeld/vbgg-website.png" width="1800" height="1416" alt={t.beeld.alt}>
            </picture>
          </div>
          <figcaption class="bijschrift">{t.beeld.bijschrift}</figcaption>
        </figure>
      </div>
    </section>

    <section class="artikel">
      <div class="wrap kolommen">
        <div class="tekst stack gap-48">
          <div class="stack gap-16">
            <h2 class="kop2">{t.vraag.kop}</h2>
            {t.vraag.alineas.map((a) => <p class="alinea">{a}</p>)}
          </div>

          <div class="stack gap-16">
            <h2 class="kop2">{t.gebouwd.kop}</h2>
            <p class="alinea">{t.gebouwd.intro}</p>
            <ul class="punten">
              {onderdelen.map((o) => (
                <li>
                  <Icon name="check" size={16} />
                  <div class="stack gap-6">
                    <h3>{o.kop}</h3>
                    <p>{o.tekst}</p>
                  </div>
                </li>
              ))}
            </ul>
            <p class="alinea">{t.gebouwd.slot}</p>
          </div>

          <div class="stack gap-16">
            <h2 class="kop2">{t.oplevert.kop}</h2>
            {t.oplevert.alineas.map((a) => <p class="alinea">{a}</p>)}
          </div>
        </div>

        <aside class="zijbalk">
          <div class="kort stack gap-16">
            <p class="eyebrow">{t.kort.eyebrow}</p>
            <dl class="feiten">
              {kort.map((r) => (
                <div class="feit">
                  <dt>{r.k}</dt>
                  <dd>{"href" in r ? <a href={r.href} rel="noopener">{r.v}</a> : r.v}{"v2" in r && <><br />{r.v2}</>}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="kaart-navy on-navy stack gap-12">
            <h2 class="kaart-kop">{t.kaart.kop}</h2>
            <p class="kaart-tekst">{t.kaart.tekst}</p>
            <a href={link("advies", taal)} class="btn btn-accent btn-klein">{t.kaart.knop}</a>
          </div>
        </aside>
      </div>
    </section>
  </article>

  <LetsTalk id="advies" />
  <FormScript />
</Base>

<style>
  .kop { padding: 96px 0 64px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a { color: var(--muted); }
  .lead { font-size: 20px; }

  .beeld { padding: 0 0 64px; }
  .bijschrift { font-size: 14px; color: var(--muted); }

  .artikel { padding: 32px 0 96px; }
  .kolommen {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 64px;
    align-items: start;
  }
  .tekst { max-width: 760px; }
  .kop2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .alinea {
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }

  .punten {
    list-style: none;
    margin: 8px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .punten li { display: flex; gap: 14px; align-items: flex-start; }
  .punten li :global(svg) { flex-shrink: 0; margin-top: 6px; color: var(--teal); stroke-width: 2.2; }
  .punten h3 { font-size: 19px; font-weight: 500; line-height: 1.35; color: var(--navy); }
  .punten p { font-size: 17px; line-height: 1.6; color: var(--muted); }

  .citaat {
    position: relative;
    margin: 0;
    padding-top: 56px;
  }
  .citaat::before {
    content: "\201C";
    position: absolute;
    top: -8px;
    left: -4px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 120px;
    line-height: 1;
    color: var(--teal);
  }
  .citaat blockquote { margin: 0; }
  .citaat blockquote p {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--navy);
    text-wrap: balance;
  }
  .citaat figcaption {
    margin-top: 24px;
    font-size: 16px;
    color: var(--muted);
  }
  .citaat figcaption strong { color: var(--navy); font-weight: 500; }
  .citaat figcaption::before {
    content: "";
    display: block;
    width: 48px;
    height: 2px;
    margin-bottom: 20px;
    background: var(--teal);
  }

  .zijbalk {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 104px;
  }
  .kort {
    padding: 28px;
    background: var(--mist);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
  }
  .feiten {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
  }
  .feit { display: flex; flex-direction: column; gap: 2px; }
  .feit dt { color: var(--muted); }
  .feit dd { margin: 0; font-weight: 500; }
  .feit dd a { text-decoration: none; }
  .feit dd a:hover { text-decoration: underline; text-decoration-color: var(--teal); text-underline-offset: 4px; }
  .kaart-navy {
    padding: 28px;
    background: var(--navy-800);
    border-radius: var(--r-card);
  }
  .kaart-kop {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .kaart-tekst { font-size: 15px; color: var(--ink-on-navy); }
  .btn-klein { min-height: 44px; padding: 0 20px; font-size: 15px; align-self: flex-start; }

  @media (max-width: 1023px) {
    .kolommen { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .zijbalk { position: static; }
  }
  @media (max-width: 767px) {
    .kop { padding: 64px 0 40px; }
    .beeld { padding-bottom: 48px; }
    .artikel { padding: 16px 0 64px; }
    .kop2 { font-size: 28px; }
    .citaat { padding-top: 48px; }
    .citaat::before { font-size: 96px; }
    .kort, .kaart-navy { padding: 22px; }
  }
</style>
