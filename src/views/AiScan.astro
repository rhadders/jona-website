---
// De AI-scan, één opmaak voor alle talen. De teksten staan in
// src/teksten/ai-scan/<taal>.ts; de routes in src/pages/<taal>/ (Duits: ki-scan.astro).
import { BEDANKT, PAGINAS, link, pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FormScript from "../components/FormScript.astro";
import SoortSelect from "../components/SoortSelect.astro";
import { bedrag, type Taal } from "../i18n/talen";
import { nl } from "../teksten/ai-scan/nl";
import { en } from "../teksten/ai-scan/en";

// Geen Duitse versie: in Duitsland bouwt Jona niet in opdracht (MAATWERK in src/i18n/talen.ts).
interface Props { taal: Exclude<Taal, "de"> }
const { taal } = Astro.props;
const t = { nl, en }[taal];
const prijs = bedrag(taal, PAGINAS.find((p) => p.id === "ai-scan")?.prijs ?? 925);
---
<Base
  {...pagina(link("ai-scan", taal))}
  current="ai-scan"
>
  <section id="ai-scan" class="top">
    <div class="wrap grid">
      <div class="stack gap-28">
        <div class="stack gap-12">
          <p class="eyebrow">{t.top.eyebrow}</p>
          <h1 class="h1 h1-sm">{t.top.kop}</h1>
          <p class="lead">{t.top.lead}</p>
        </div>
        <ol class="steps">
          {t.top.stappen.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <div class="stack gap-6">
                <h3>{s.kop}</h3>
                <p class="muted">{s.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="stack gap-24">
        <div class="offer stack gap-20">
          <h2 class="h3">{t.aanbod.kop}</h2>
          <ul class="checks">
            {t.aanbod.punten.map((p) => (
              <li><Icon name="check" /><span>{p}</span></li>
            ))}
          </ul>
          <div class="prijs stack gap-6">
            <span class="small muted">{t.aanbod.vastePrijs}</span>
            <span class="bedrag">{prijs} <span class="small muted sans">{t.aanbod.exclusief}</span></span>
          </div>
          <a href="#aanvraag" class="btn btn-primary">{t.aanbod.knop} <Icon name="arrow-right" /></a>
          <p class="small muted">{t.aanbod.contact}</p>
        </div>
        <p class="muted hint">{t.aanbod.hint} <a href={link("advies", taal)}>{t.aanbod.hintLink}</a>.</p>
      </div>
    </div>
  </section>

  <section class="section section-mist voorwie">
    <div class="wrap stack gap-40">
      <div class="narrow stack gap-12">
        <p class="eyebrow">{t.voorWie.eyebrow}</p>
        <h2 class="h2">{t.voorWie.kop}</h2>
      </div>
      <div class="grid-3">
        {t.voorWie.kaarten.map((k) => (
          <div class="card kaart stack gap-12">
            <h3>{k.kop}</h3>
            <p class="muted">{k.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="aanvraag" class="section">
    <div class="wrap grid">
      <div class="stack gap-16">
        <p class="eyebrow">{t.aanvraag.eyebrow}</p>
        <h2 class="h2">{t.aanvraag.kop}</h2>
        <p class="muted intro">{t.aanvraag.intro}</p>
      </div>
      <form class="form formcard" method="post" action="/api/ai-scan" data-form="ai-scan" data-bedankt={BEDANKT[taal]} novalidate>
        <input type="hidden" name="_bron" value="">
        <input type="hidden" name="_taal" value={taal}>
        <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="row">
          <div class="field">
            <label for="s-naam">{t.form.naam}</label>
            <input id="s-naam" name="naam" type="text" autocomplete="name" required>
            <span class="err" data-error-for="naam"></span>
          </div>
          <div class="field">
            <label for="s-rol">{t.form.rol}</label>
            <input id="s-rol" name="rol" type="text" placeholder={t.form.rolVoorbeeld}>
          </div>
        </div>
        <div class="field">
          <label for="s-org">{t.form.organisatie}</label>
          <input id="s-org" name="organisatie" type="text" placeholder={t.form.organisatieVoorbeeld} autocomplete="organization" required>
          <span class="err" data-error-for="organisatie"></span>
        </div>
        <div class="row">
          <div class="field">
            <label for="s-soort">{t.form.soort}</label>
            <SoortSelect id="s-soort" standaard="bedrijf" />
          </div>
          <div class="field">
            <label for="s-mensen">{t.form.mensen}</label>
            <select id="s-mensen" name="mensen">
              {t.form.mensenOpties.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="s-email">{t.form.email}</label>
            <input id="s-email" name="email" type="email" placeholder={t.form.emailVoorbeeld} autocomplete="email" required>
            <span class="err" data-error-for="email"></span>
          </div>
          <div class="field">
            <label for="s-tel">{t.form.telefoon} <span class="opt">{t.form.nietVerplicht}</span></label>
            <input id="s-tel" name="telefoon" type="tel" placeholder={t.form.telefoonVoorbeeld} autocomplete="tel">
          </div>
        </div>
        <div class="field">
          <label for="s-bericht">{t.form.bericht}</label>
          <textarea id="s-bericht" name="bericht" rows="4" placeholder={t.form.berichtVoorbeeld}></textarea>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
        <button type="submit" class="btn btn-primary btn-block btn-52">{t.form.knop} <Icon name="arrow-right" /></button>
        <p class="note">{t.form.noot} <a href="mailto:info@jonatechnologie.nl">info@jonatechnologie.nl</a></p>
      </form>
    </div>
  </section>
  <FormScript />
</Base>

<style>
  .top { padding: 112px 0 96px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 64px;
    align-items: start;
  }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .offer {
    padding: 32px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
  }
  .prijs { padding-top: 16px; border-top: 1px solid var(--border); }
  .bedrag { font-family: var(--font-serif); font-size: 28px; letter-spacing: -0.015em; }
  .sans { font-family: var(--font-sans); letter-spacing: 0; }
  .hint { font-size: 15px; }
  .voorwie { padding: 80px 0; }
  .kaart { padding: 24px; }
  .kaart h3 { font-size: 19px; font-weight: 500; }
  .kaart p { font-size: 16px; }
  .intro { font-size: 18px; }
  .formcard {
    padding: 40px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
  }
  .btn-52 { min-height: 52px; }
  .err { font-size: 13px; color: var(--warn-ink); }
  .err:empty { display: none; }
  @media (max-width: 767px) {
    .top { padding: 72px 0 64px; }
    .grid { gap: 40px; }
    .voorwie { padding: 64px 0; }
    .formcard { padding: 24px 20px; }
    .offer { padding: 24px 20px; }
  }
  @media (max-width: 479px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
