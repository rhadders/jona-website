---
import { pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LetsTalk from "../components/LetsTalk.astro";
import FormScript from "../components/FormScript.astro";
---
<Base
  {...pagina("/")}
>
  <section id="top" class="hero">
    <a href="/over-jona#waarom-jona" class="duif" aria-label="Het verhaal achter de duif: lees waarom Jona een duif als beeldmerk heeft">
      <img src="/logo/jona-mark.svg" alt="" class="hero-mark" width="520" height="520">
      <span class="duif-label" aria-hidden="true">Het verhaal achter de duif? <strong>Klik hier <Icon name="arrow-right" size={16} /></strong></span>
    </a>
    <div class="wrap narrow stack gap-28 hero-inner">
      <p class="eyebrow">Missiegedreven software &amp; AI</p>
      <h1 class="h1">Zinvolle technologie voor bedrijven en organisaties <br class="br-wide">met een missie</h1>
      <p class="lead">Wij bouwen gebruiksvriendelijke software en AI voor complexe processen. Vanuit onze jarenlange ervaring met techniek binnen missiegedreven organisaties, weten we wat er nodig is om software écht fijn te laten werken.</p>
      <div class="actions">
        <a href="#producten" class="btn btn-primary"><span>Bekijk onze software</span> <Icon name="arrow-right" /></a>
        <a href="/advies" class="btn btn-secondary">Plan een kennismaking</a>
      </div>
    </div>
  </section>

  <section id="producten" class="section section-mist">
    <div class="wrap stack gap-56">
      <div class="stack gap-12 narrow">
        <p class="eyebrow">Onze eigen software</p>
        <h2 class="h2">Oogstrelende apps waarmee we de harten van gebruikers stelen.</h2>
      </div>

      <article class="product">
        <div class="screen">
          <picture>
            <source srcset="/beeld/actuelegegevens-site.webp" type="image/webp">
            <img src="/beeld/actuelegegevens-site.png" width="1800" height="1145" loading="lazy" alt="De website van ActueleGegevens.nl: laat je relaties hun gegevens zelf controleren, met een campagneoverzicht ernaast">
          </picture>
        </div>
        <div class="stack gap-16">
          <span class="tag">Publieke beta is live</span>
          <h3 class="h2-sm">ActueleGegevens.nl</h3>
          <p class="product-text">De worsteling van elke organisatie: hoe houd je je relatiebestand actueel? Verouderde of onjuiste gegevens kosten geld. Met deze online tool zet je binnen 10 minuten een campagne op en laat je jouw relaties zelf hun gegevens controleren en aanvullen.</p>
          <a href="/actuelegegevens" class="link">Meer over ActueleGegevens.nl</a>
          <div class="actions">
            <a href="/actuelegegevens#testgebruiker" class="btn btn-primary"><span>Meld je aan als testgebruiker</span> <Icon name="arrow-right" /></a>
          </div>
        </div>
      </article>

      <article class="product">
        <div class="screen">
          <picture>
            <source srcset="/beeld/selaread-ontdek.webp" type="image/webp">
            <img src="/beeld/selaread-ontdek.png" width="1800" height="1177" loading="lazy" alt="De pagina Ontdek in Selaread: een zoekveld, rubrieken als Israël, Kerkbladen en Kinderen, en een overzicht van magazines met hun omslagen">
          </picture>
        </div>
        <div class="stack gap-16">
          <span class="tag">Lancering voorjaar 2027</span>
          <h3 class="h2-sm">Selaread</h3>
          <p class="product-text">Lees onbeperkt christelijke tijdschriften, op mobiel, tablet of desktop. Selaread is een moderne kioskapp. Ook voor uitgevers die op zoek zijn naar een leesapp voor hun eigen abonnees.</p>
          <a href="/selaread" class="link">Meer over Selaread</a>
          <div class="actions">
            <a href="/selaread#beta" class="btn btn-primary"><span>Meld je aan als testgebruiker</span> <Icon name="arrow-right" /></a>
          </div>
        </div>
      </article>

      <article class="product">
        <div class="screen">
          <picture>
            <source srcset="/beeld/tirgumai-start.webp" type="image/webp">
            <img src="/beeld/tirgumai-start.png" width="1800" height="1125" loading="lazy" alt="Het startscherm van TirgumAI: Genesis 1:1 in het Hebreeuws met de eigen vertaling eronder, knoppen Verder vertalen en Hoofdstuk lezen, en de projecten">
          </picture>
        </div>
        <div class="stack gap-16">
          <span class="tag">Wordt verwacht in 2027</span>
          <h3 class="h2-sm">TirgumAI</h3>
          <p class="product-text">De nieuwste generatie bijbelsoftware. Vertaal vanuit de grondtekst met behulp van AI, verrijk de bijbeltekst met commentaar en publiceer een volledige studiebijbel. Geschikt voor zowel professionele vertalers als amateur-theologen.</p>
          <a href="/tirgumai" class="link">Meer over TirgumAI</a>
          <div class="actions">
            <a href="/tirgumai#op-de-hoogte" class="btn btn-outline"><span>Houd me op de hoogte</span> <Icon name="arrow-right" /></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="maatwerk" class="maatwerk">
    <div class="wrap narrow stack gap-24">
      <p class="eyebrow">Maatwerk software</p>
      <h2 class="h2">Wat er niet is, kan gemaakt worden</h2>
      <p class="maatwerk-lead">Onder de indruk van de software die wij bouwen? Loop je zelf rond met een idee voor jouw bedrijf of organisatie? Wij bouwen ook software en AI op maat, via ons zusterbedrijf <a href="https://echonova.nl" target="_blank" rel="noopener">EchoNova</a>. Altijd vanuit twee eenvoudige principes:</p>
      <div class="principes">
        <div class="principe">
          <span class="cijfer">1</span>
          <div class="stack gap-6">
            <h3>Wij maken software betaalbaar en duurzaam</h3>
            <p class="muted">Dankzij AI kan met een klein budget zeer geavanceerde software gebouwd worden, die in kwaliteit niet onderdoet ten opzichte van grote ontwikkelstudio's. Maar we gaan niet zomaar bouwen: we denken eerst mee in wat écht nodig is en wat ook op de lange termijn van belang kan zijn. Zodat software ook een duurzame keuze is.</p>
          </div>
        </div>
        <div class="principe">
          <span class="cijfer">2</span>
          <div class="stack gap-6">
            <h3>Wij maken software eenvoudig en aantrekkelijk</h3>
            <p class="muted">Software waarbij een consultant of cursus nodig is voor je ermee kunt werken, is in onze ogen niet goed ontworpen. Ook al zijn processen nog zo complex, wij doen er alles aan om ze eenvoudig, duidelijk en gebruiksvriendelijk te maken. In een ontwerp dat aantrekkelijk oogt. Zodat je met plezier naar je beeldscherm kijkt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="verhaal" class="verhaal">
    <div class="wrap">
      <div class="carrousel" data-carrousel aria-roledescription="carrousel" aria-label="Gemaakt voor een klant">
        <div class="slides" data-slides>
          <article class="slide grid-2" role="group" aria-roledescription="slide" aria-label="1 van 4">
            <div class="screen">
              <picture>
                <source srcset="/beeld/hadders-media-beheer.webp" type="image/webp">
                <img src="/beeld/hadders-media-beheer.png" width="1800" height="1416" loading="lazy" alt="Het beheer van het livestreamplatform van Hadders Media: de livestreams van vandaag met per uitzending de opdrachtgever, de status (terugkijken, live of gepland), de toegangscode en het aantal reacties, en daaronder de komende uitzendingen">
              </picture>
            </div>
            <div class="stack gap-20">
              <p class="eyebrow">Gemaakt voor een klant</p>
              <h2 class="h2-sm">Een afscheid volgen, waar je ook bent en welke taal je ook spreekt.</h2>
              <p class="muted">Hadders Media maakt het mogelijk om op afstand bij een afscheid te zijn en biedt als eerste in Nederland live ondertiteling en nasynchronisatie aan bij uitvaarten. Wij bouwden een eigen platform dat livestreams, vertalingen en condoleances samenbrengt. Eenvoudig te beheren voor Hadders Media en toegankelijk voor familie en vrienden, overal ter wereld.</p>
              <a href="/klantverhaal/hadders-media" class="link self-start">Lees het klantverhaal <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>

          <article class="slide slide-mockup grid-2" role="group" aria-roledescription="slide" aria-label="2 van 4">
            <div class="mockup">
              <picture>
                <source srcset="/beeld/holy-moly-ipad.webp" type="image/webp">
                <img src="/beeld/holy-moly-ipad.png" width="1200" height="1490" loading="lazy" alt="Een iPad, schuin in beeld, met een lopend potje van de Holy Moly!-app: een rij bijbelse personages voor de stadspoort en daaronder de handkaarten van de speler">
              </picture>
            </div>
            <div class="stack gap-20">
              <p class="eyebrow">Gemaakt voor een klant</p>
              <h2 class="h2-sm">Een game app voor een kaartspel van bijbelse proporties.</h2>
              <p class="muted">Holy Moly! is een kaartspel dat medio 2027 verschijnt. Wij bouwden een app voor iOS en Android, waarin je het spel kunt spelen tegen de computer. Strategisch, geestig en een tikkeltje zondig.</p>
              <a href="/klantverhaal/holy-moly" class="link self-start">Lees het klantverhaal <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>

          <article class="slide grid-2" role="group" aria-roledescription="slide" aria-label="3 van 4">
            <div class="screen">
              <picture>
                <source srcset="/beeld/vbgg-website.webp" type="image/webp">
                <img src="/beeld/vbgg-website.png" width="1800" height="1416" loading="lazy" alt="De homepage van vakantiewekenvbgg.nl: bovenaan de knoppen Meegaan als staflid en Meegaan als gast, daaronder een foto van twee mannen op een duofiets met de tekst Samen uit, samen één">
              </picture>
            </div>
            <div class="stack gap-20">
              <p class="eyebrow">Gemaakt voor een klant</p>
              <h2 class="h2-sm">Van papieren administratie naar één portal dat zich aanpast aan elke doelgroep.</h2>
              <p class="muted">De Vakantieweken van de Vrouwenbond Gereformeerde Gemeenten geven ieder jaar meer dan 600 gasten een week vakantie, met hulp van ruim 450 vrijwilligers en zorgprofessionals. Wij brachten alle aanmeldingen en de administratie eromheen samen in één systeem, gekoppeld aan de website.</p>
              <a href="/klantverhaal/vbgg" class="link self-start">Lees het klantverhaal <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>

          <article class="slide slide-mockup grid-2" role="group" aria-roledescription="slide" aria-label="4 van 4">
            <div class="mockup">
              <picture>
                <source srcset="/beeld/bc-app-iphone.webp" type="image/webp">
                <img src="/beeld/bc-app-iphone.png" width="992" height="1490" loading="lazy" alt="Een iPhone, schuin in beeld, met het welkomstscherm van de BC app: de zegelring als uitgelicht voorwerp en daaronder de categorieën met voorwerpen">
              </picture>
            </div>
            <div class="stack gap-20">
              <p class="eyebrow">Gemaakt voor een klant</p>
              <h2 class="h2-sm">Een app die de voorwerpen uit de Bijbel laat spreken.</h2>
              <p class="muted">Bij het boek De Zin der Dingen van Jaap Bönker en Ruben Hadders bouwden wij voor de Bijbelse Cultuur Stichting een app voor iOS en Android. Met beschrijvingen van meer dan 125 gebruiksvoorwerpen uit de Bijbel en hun symbolische betekenis, om te lezen of te luisteren.</p>
              <a href="/klantverhaal/bc-app" class="link self-start">Lees het klantverhaal <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>
        </div>

        <div class="carrousel-nav" data-nav hidden>
          <button type="button" class="pijl" data-prev aria-label="Vorige klant"><Icon name="chevron-left" size={20} /></button>
          <div class="dots">
            <button type="button" class="dot" data-dot aria-label="Ga naar Hadders Media" aria-current="true"></button>
            <button type="button" class="dot" data-dot aria-label="Ga naar Holy Moly!" aria-current="false"></button>
            <button type="button" class="dot" data-dot aria-label="Ga naar Vakantieweken VBGG" aria-current="false"></button>
            <button type="button" class="dot" data-dot aria-label="Ga naar de BC app" aria-current="false"></button>
          </div>
          <button type="button" class="pijl" data-next aria-label="Volgende klant"><Icon name="chevron-right" size={20} /></button>
        </div>
      </div>
    </div>
  </section>

  <LetsTalk id="advies" />
  <FormScript />
</Base>

<script>
  // Carrousel "Gemaakt voor een klant": een scrollende baan met snappunten.
  // Zonder JavaScript blijft de baan gewoon te vegen; de knoppen komen er met JavaScript bij.
  // De baan loopt rond: vóór de eerste slide staat een kopie van de laatste en na de laatste
  // een kopie van de eerste. Komt de baan op een kopie tot stilstand, dan springt hij
  // ongemerkt naar het origineel, zodat je eindeloos door kunt klikken of vegen.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const root of document.querySelectorAll<HTMLElement>("[data-carrousel]")) {
    const track = root.querySelector<HTMLElement>("[data-slides]");
    const echt = Array.from(root.querySelectorAll<HTMLElement>(".slide"));
    const nav = root.querySelector<HTMLElement>("[data-nav]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const n = echt.length;
    if (!track || !nav || n < 2) continue;

    const kopie = (el: HTMLElement) => {
      const k = el.cloneNode(true) as HTMLElement;
      k.setAttribute("aria-hidden", "true");
      k.inert = true;
      k.querySelectorAll("img").forEach((img) => (img.loading = "eager"));
      return k;
    };
    track.prepend(kopie(echt[n - 1]));
    track.append(kopie(echt[0]));
    const alle = Array.from(track.children) as HTMLElement[]; // posities 0..n+1, de echte slides op 1..n

    nav.hidden = false;
    root.classList.add("is-js");
    let pos = 1;
    let doel = 1;
    let rust = 0;

    const offset = (p: number) => alle[p].offsetLeft - alle[0].offsetLeft;
    const spring = (p: number) => {
      pos = p;
      track.scrollTo({ left: offset(p), behavior: "instant" });
    };
    const lees = () => {
      const stap = offset(1) || 1;
      pos = Math.max(0, Math.min(n + 1, Math.round(track.scrollLeft / stap)));
      const i = (pos - 1 + n) % n;
      dots.forEach((d, k) => d.setAttribute("aria-current", String(k === i)));
    };
    // Op een kopie tot stilstand gekomen: naar het origineel.
    const herstel = () => {
      if (pos === 0) spring(n);
      else if (pos === n + 1) spring(1);
      doel = pos;
    };
    // doel is waar de baan naartoe onderweg is, zodat snel achter elkaar klikken geen klik verliest.
    const goTo = (p: number) => {
      doel = p;
      track.scrollTo({ left: offset(p), behavior: reduced ? "instant" : "smooth" });
    };
    const stap = (d: number) => {
      if (doel === 0) spring(n);
      else if (doel === n + 1) spring(1);
      else pos = doel;
      goTo(pos + d);
    };

    prev?.addEventListener("click", () => stap(-1));
    next?.addEventListener("click", () => stap(1));
    dots.forEach((d, k) => d.addEventListener("click", () => goTo(k + 1)));
    track.addEventListener("scroll", () => {
      lees();
      clearTimeout(rust);
      rust = window.setTimeout(herstel, 140);
    }, { passive: true });
    window.addEventListener("resize", () => { spring(pos === 0 ? n : pos === n + 1 ? 1 : pos); doel = pos; });
    spring(1);
    lees();
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 128px 0 112px;
  }
  /* De duif is een link naar "Waarom Jona". Alleen met een muis reageert het vlak; op touch blijft het een rustig decor. */
  .duif {
    position: absolute;
    top: 48px;
    right: 64px;
    width: 520px;
    height: 520px;
    display: block;
    z-index: 1;
    pointer-events: none;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .hero-mark {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .duif-label {
    position: absolute;
    left: 62%;
    bottom: 8%;
    transform: translate(-50%, 10px);
    display: inline-flex;
    gap: 6px;
    align-items: center;
    white-space: nowrap;
    padding: 12px 20px;
    border-radius: var(--r-pill);
    background: var(--navy);
    color: var(--white);
    font-size: 15px;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .duif-label strong {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-weight: 500;
    color: var(--teal-300);
  }
  @media (hover: hover) {
    .duif { pointer-events: auto; }
    .duif:hover .hero-mark { opacity: 0.2; transform: translateY(-6px) rotate(-2deg); }
  }
  .duif:hover .duif-label,
  .duif:focus-visible .duif-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .duif:focus-visible { outline: 2px solid var(--teal); outline-offset: -2px; border-radius: var(--r-card); }
  .duif:focus-visible .hero-mark { opacity: 0.2; }
  @media (prefers-reduced-motion: reduce) {
    .hero-mark, .duif-label { transition: none; }
    .duif:hover .hero-mark { transform: none; }
  }
  .hero-inner { position: relative; }
  .lead { max-width: 62ch; }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 8px;
  }
  .product {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px;
    align-items: center;
  }
  .product-text { font-size: 18px; }
  .maatwerk { padding: 112px 0 0; }
  .maatwerk-lead { font-size: 19px; line-height: 1.6; }
  .principes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px 40px;
    padding-top: 8px;
  }
  .principe { display: flex; gap: 16px; align-items: flex-start; }
  .principe h3 { font-size: 17px; font-weight: 500; }
  .principe p { font-size: 16px; }
  .cijfer {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1;
    color: var(--teal);
    flex-shrink: 0;
    min-width: 20px;
    padding-top: 2px;
  }
  .verhaal { padding: 144px 0; }
  .self-start { align-self: flex-start; }

  /* carrousel: de baan bloedt de goot in, zodat de schaduw van het scherm niet wordt afgesneden */
  .slides {
    position: relative;
    display: flex;
    gap: calc(var(--gutter) * 2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    margin: -24px calc(-1 * var(--gutter)) -40px;
    padding: 24px var(--gutter) 64px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .is-js .slides { scrollbar-width: none; }
  .is-js .slides::-webkit-scrollbar { display: none; }
  /* mockup zonder kader: de afbeelding heeft zelf een witte achtergrond en schaduw */
  .mockup { display: flex; justify-content: center; }
  /* naast de tekst: de kolom is zo breed als de mockup zelf, en beeld en tekst staan samen in het midden */
  @media (min-width: 768px) {
    .slide-mockup { grid-template-columns: auto minmax(0, 520px); justify-content: center; }
  }
  .mockup img { display: block; width: auto; max-width: 100%; height: auto; max-height: 560px; }
  .slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .carrousel-nav {
    /* boven de baan, die onderaan doorloopt voor de schaduw van het scherm */
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding-top: 8px;
  }
  .dots { display: flex; gap: 10px; }
  .dot {
    width: 12px;
    height: 12px;
    padding: 0;
    border-radius: var(--r-pill);
    border: 2px solid var(--teal);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .dot:hover,
  .dot[aria-current="true"] { background: var(--teal); }
  .pijl {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-pill);
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .pijl:hover { border-color: var(--navy); }
  .product-text + .link { align-self: flex-start; }

  @media (max-width: 1023px) {
    .duif { width: 380px; height: 380px; right: -40px; top: 40px; }
  }
  @media (max-width: 767px) {
    .hero { padding: 72px 0 64px; }
    .duif { width: 260px; height: 260px; right: -60px; top: 20px; }
    .hero-mark { opacity: 0.06; }
    .br-wide { display: none; }
    .maatwerk { padding-top: 64px; }
    .verhaal { padding: 80px 0; }
    .carrousel-nav { padding-top: 4px; }
    .product { gap: 28px; }
  }
  @media (max-width: 479px) {
    .product { grid-template-columns: minmax(0, 1fr); }
    .actions .btn { width: 100%; }
  }
</style>
