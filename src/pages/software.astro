---
import { pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

// Overzicht van alle eigen software. Nieuwe app? Zet hem in een van de twee
// lijsten; de vergelijkingstabel onderaan leest uit allebei.
interface App {
  naam: string;
  pad: string;
  tag: string;
  voor: string;
  tekst: string;
  beeld: string;
  breed: number;
  hoog: number;
  alt: string;
  actie: string;
  actieHref: string;
}

const nu: App[] = [
  {
    naam: "Jona Giften",
    pad: "/jonagiften",
    tag: "Nu beschikbaar",
    voor: "Kleine stichtingen en hun penningmeester",
    tekst: "De giftenadministratie voor kleine stichtingen. Houd donateurs, giften en machtigingen bij op één plek, laat mensen online geven per project en stuur met één klik alle jaaroverzichten. Zo eenvoudig dat elke penningmeester ermee overweg kan.",
    beeld: "/beeld/jonagiften-jaar",
    breed: 1600,
    hoog: 1000,
    alt: "Het jaaroverzicht in Jona Giften: wat er dit jaar binnenkwam, maand voor maand, en alle giften van november",
    actie: "Probeer 14 dagen gratis",
    actieHref: "https://jonagiften.nl/aanmelden",
  },
  {
    naam: "Jona Bestuur",
    pad: "/jonabestuur",
    tag: "Nu beschikbaar",
    voor: "Kleine besturen en hun secretaris",
    tekst: "Agenda, notulen en besluiten voor kleine besturen. Vergader punt voor punt: wat is besproken, wat is besloten en wie doet wat. Na het laatste agendapunt staan de conceptnotulen klaar, en elk besluit vind je terug in het besluitenregister.",
    beeld: "/beeld/jonabestuur-vergadermodus",
    breed: 1600,
    hoog: 1000,
    alt: "De vergadermodus van Jona Bestuur: links de agenda, rechts agendapunt 6, Begroting 2027, met drie vragen: wat is er besproken, wat is besloten en wie doet wat",
    actie: "Probeer 14 dagen gratis",
    actieHref: "https://jonabestuur.nl/aanmelden",
  },
  {
    naam: "ActueleGegevens.nl",
    pad: "/actuelegegevens",
    tag: "Publieke beta is live",
    voor: "Elke organisatie met een relatiebestand",
    tekst: "De worsteling van elke organisatie: hoe houd je je relatiebestand actueel? Met deze online tool zet je binnen 10 minuten een campagne op en laat je jouw relaties zelf hun gegevens controleren en aanvullen.",
    beeld: "/beeld/actuelegegevens-site",
    breed: 1800,
    hoog: 1145,
    alt: "De website van ActueleGegevens.nl: laat je relaties hun gegevens zelf controleren, met een campagneoverzicht ernaast",
    actie: "Meld je aan als testgebruiker",
    actieHref: "/actuelegegevens#testgebruiker",
  },
];

const binnenkort: App[] = [
  {
    naam: "Selaread",
    pad: "/selaread",
    tag: "Lancering voorjaar 2027",
    voor: "Lezers van christelijke tijdschriften en uitgevers",
    tekst: "Lees onbeperkt christelijke tijdschriften, op mobiel, tablet of desktop. Selaread is een moderne kioskapp. Ook voor uitgevers die op zoek zijn naar een leesapp voor hun eigen abonnees.",
    beeld: "/beeld/selaread-ontdek",
    breed: 1800,
    hoog: 1177,
    alt: "De pagina Ontdek in Selaread: een zoekveld, rubrieken als Israël, Kerkbladen en Kinderen, en een overzicht van magazines met hun omslagen",
    actie: "Meld je aan als testgebruiker",
    actieHref: "/selaread#beta",
  },
  {
    naam: "TirgumAI",
    pad: "/tirgumai",
    tag: "Wordt verwacht in 2027",
    voor: "Bijbelvertalers en amateur-theologen",
    tekst: "De nieuwste generatie bijbelsoftware. Vertaal vanuit de grondtekst met behulp van AI, verrijk de bijbeltekst met commentaar en publiceer een volledige studiebijbel.",
    beeld: "/beeld/tirgumai-start",
    breed: 1800,
    hoog: 1125,
    alt: "Het startscherm van TirgumAI: Genesis 1:1 in het Hebreeuws met de eigen vertaling eronder, knoppen Verder vertalen en Hoofdstuk lezen, en de projecten",
    actie: "Houd me op de hoogte",
    actieHref: "/tirgumai#op-de-hoogte",
  },
];

const extern = (href: string) => href.startsWith("http");
---
<Base
  {...pagina("/software")}
  current="software"
>
  <section class="kop">
    <img src="/logo/jona-mark.svg" alt="" class="kop-duif" width="420" height="420">
    <div class="wrap">
      <div class="narrow stack gap-20">
        <p class="eyebrow">Onze software</p>
        <h1 class="h1">Alle apps die we zelf bouwen, op één plek</h1>
        <p class="lead">Van giftenadministratie en bestuursvergaderingen tot bijbelvertaling: software voor organisaties met een missie. Sommige apps kun je vandaag al gebruiken, andere zijn in de maak. Kijk gerust rond.</p>
      </div>
    </div>
  </section>

  <section class="groep groep-nu" aria-labelledby="nu">
    <div class="wrap stack gap-28">
      <h2 id="nu" class="groep-kop"><span class="stip" aria-hidden="true"></span>Nu te gebruiken</h2>
      {nu.map((app) => (
        <article class="app-breed">
          <div class="app-beeld">
            <picture>
              <source srcset={`${app.beeld}.webp`} type="image/webp">
              <img src={`${app.beeld}.png`} width={app.breed} height={app.hoog} loading="lazy" alt={app.alt}>
            </picture>
          </div>
          <div class="app-tekst stack gap-16">
            <span class="tag">{app.tag}</span>
            <h3 class="h2-sm">{app.naam}</h3>
            <p class="muted">{app.tekst}</p>
            <div class="acties">
              <a href={app.actieHref} rel={extern(app.actieHref) ? "noopener" : undefined} class="btn btn-primary"><span>{app.actie}</span> <Icon name="arrow-right" /></a>
              <a href={app.pad} class="link">Meer over {app.naam}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="groep groep-straks" aria-labelledby="binnenkort">
    <div class="wrap stack gap-28">
      <h2 id="binnenkort" class="groep-kop"><span class="stip stip-open" aria-hidden="true"></span>Binnenkort</h2>
      <div class="straks-raster">
        {binnenkort.map((app) => (
          <article class="app-klein">
            <div class="app-klein-beeld">
              <picture>
                <source srcset={`${app.beeld}.webp`} type="image/webp">
                <img src={`${app.beeld}.png`} width={app.breed} height={app.hoog} loading="lazy" alt={app.alt}>
              </picture>
            </div>
            <div class="app-klein-tekst stack gap-12">
              <p class="eyebrow">{app.tag}</p>
              <h3 class="h3 h3-groot">{app.naam}</h3>
              <p class="muted groei">{app.tekst}</p>
              <div class="acties">
                <a href={app.actieHref} class="btn btn-secondary btn-wit">{app.actie}</a>
                <a href={app.pad} class="link">Meer over {app.naam}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-mist" aria-labelledby="vergelijk">
    <div class="wrap stack gap-28">
      <h2 id="vergelijk" class="h2-sm">Welke app past bij jou?</h2>
      <div class="tabel-doos">
        <table>
          <thead>
            <tr>
              <th scope="col">App</th>
              <th scope="col">Voor wie</th>
              <th scope="col">Wanneer</th>
              <th scope="col"><span class="visually-hidden">Aan de slag</span></th>
            </tr>
          </thead>
          <tbody>
            {[...nu, ...binnenkort].map((app) => (
              <tr>
                <th scope="row"><a href={app.pad}>{app.naam}</a></th>
                <td class="muted">{app.voor}</td>
                <td><span class="tag">{app.tag}</span></td>
                <td class="rechts"><a href={app.actieHref} rel={extern(app.actieHref) ? "noopener" : undefined} class="link">{app.actie}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="maatwerk">
    <div class="wrap maatwerk-rij">
      <div class="stack gap-6 maatwerk-tekst">
        <h2 class="h3 h3-groot">Liever software op maat?</h2>
        <p class="muted">Via ons zusterbedrijf <a href="https://echonova.nl" target="_blank" rel="noopener">EchoNova</a> bouwen we ook software en AI voor jouw organisatie.</p>
      </div>
      <a href="/advies" class="btn btn-primary"><span>Plan een kennismaking</span> <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>

<style>
  .kop {
    position: relative;
    overflow: hidden;
    padding: 96px 0 72px;
  }
  .kop .wrap { position: relative; }
  .kop-duif {
    position: absolute;
    right: -60px;
    top: -40px;
    width: 420px;
    height: 420px;
    opacity: 0.08;
    pointer-events: none;
  }

  .groep { padding: 56px 0; }
  .groep-nu { padding-top: 0; }
  .groep-straks { padding-bottom: 96px; }
  .groep-kop {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .stip {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-radius: var(--r-pill);
    background: var(--teal);
  }
  .stip-open { background: transparent; border: 2px solid var(--teal); }

  .app-breed {
    display: flex;
    flex-wrap: wrap;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .app-beeld { flex: 1 1 460px; min-width: 0; background: var(--mist); }
  .app-beeld img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .app-tekst {
    flex: 1 1 380px;
    min-width: 0;
    padding: 40px;
    justify-content: center;
  }

  .straks-raster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
  }
  .app-klein {
    display: flex;
    flex-direction: column;
    background: var(--mist);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .app-klein-beeld {
    margin: 24px 24px 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-notice);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .app-klein-beeld img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .app-klein-tekst { padding: 24px 32px 32px; flex-grow: 1; }
  .groei { flex-grow: 1; }
  .h3-groot { font-size: 28px; }

  .acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding-top: 6px;
  }
  .btn-wit { background: var(--white); border-color: var(--navy); }

  .tabel-doos {
    position: relative;
    overflow-x: auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
  }
  table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }
  thead th {
    padding: 20px 28px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-700);
  }
  tbody tr { border-top: 1px solid var(--border); }
  tbody th, tbody td { padding: 20px 28px; vertical-align: middle; }
  tbody th {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 20px;
  }
  tbody th a { text-decoration: none; }
  tbody .tag { white-space: nowrap; }
  .rechts { text-align: right; white-space: nowrap; }

  .maatwerk { padding: 88px 0; }
  .maatwerk-rij {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .maatwerk-tekst { max-width: 640px; }

  @media (max-width: 767px) {
    .kop { padding: 64px 0 48px; }
    .kop-duif { width: 260px; height: 260px; right: -60px; top: -20px; opacity: 0.06; }
    .app-tekst { padding: 28px 24px; }
    .app-klein-beeld { margin: 16px 16px 0; }
    .app-klein-tekst { padding: 20px 24px 28px; }
    .groep { padding: 40px 0; }
    .groep-straks { padding-bottom: 64px; }
    .maatwerk { padding: 64px 0; }
  }
  @media (max-width: 479px) {
    .app-beeld, .app-tekst { flex-basis: 100%; }
    .straks-raster { grid-template-columns: minmax(0, 1fr); }
    .acties .btn { width: 100%; }
  }
</style>
