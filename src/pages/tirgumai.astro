---
import { pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FormScript from "../components/FormScript.astro";

// De zes stappen van het vertaalwerk; de middelste drie krijgen AI-ondersteuning.
const stappen = [
  { icon: "book-open", label: "Lezen", ai: false },
  { icon: "bars", label: "Begrijpen", ai: true },
  { icon: "sparkles", label: "Vertalen", ai: true },
  { icon: "circle-check", label: "Controleren", ai: true },
  { icon: "users", label: "Samenwerken", ai: false },
  { icon: "upload", label: "Publiceren", ai: false },
] as const;

const groepen = [
  { kop: "De grondtekst lezen", ai: false, punten: [
    "Hebreeuws, Aramees en Grieks woord voor woord, met lemma, vorm, Strong's, transliteratie en uitspraak",
    "Zinsbouw en de betekenis van een woord in één oogopslag",
    "Vergelijkingsteksten (o.a. Nestle 1904, Tischendorf en Westcott-Hort)",
    "Concordantie op Strong's, lemma of grammaticale vorm, in de hele Bijbel of in één passage",
  ] },
  { kop: "De achtergrond begrijpen", ai: true, punten: [
    "Woordenboeken (o.a. Brown-Driver-Briggs, Abbott-Smith en Strong's)",
    "Tekstvarianten met toelichting bij 4.515 plaatsen in het Oude Testament",
    "Parallelle passages naast elkaar weergeven",
    "Personen, plaatsen en namen toegelicht",
    "Handboeken, commentaren en studienotities",
  ] },
  { kop: "Vertalen met hulp van AI", ai: true, punten: [
    "Richtlijnen voor stijl, register, godsnamen, aanspreekvorm, poëzie en eerbiedshoofdletters",
    "Een AI-vertaling per vers of de hele Bijbel in één keer",
    "Een projectglossarium met voorkomens en afwijkingen zichtbaar gemaakt",
    "Een AI-assistent die je helpt de grondtekst te begrijpen en weloverwogen vertaalkeuzes te maken",
    "Een AI-controle van jouw vertaling tegen de grondtekst",
  ] },
  { kop: "Controleren op consistentie", ai: true, punten: [
    "Consistentie in twee richtingen: één grondwoord met meer vertalingen, één doelwoord voor meer grondwoorden",
    "Taalfouten in de doeltaal: spaties, leestekens, open aanhalingstekens en de spelling van eigennamen",
  ] },
  { kop: "Vertalen in teamverband", ai: false, punten: [
    "Ondersteuning voor meerdere projecten",
    "Overleg met teamleden over de beste vertaling",
    "Volledige geschiedenis per vers en een logboek per project",
    "Vier gebruikersrollen: meelezer, vertaler, reviewer en manager",
  ] },
  { kop: "Publiceren", ai: false, punten: [
    "Complete Bijbels en studiebijbels automatisch gezet met kant-en-klare templates, drukklaar met afloop en snijtekens",
    "Je eigen online studiebijbel, met een leesstand en een studiestand",
    "Export naar Word, PDF, EPUB, USFM 3.1, USX en USJ",
    "PTXprint-pakket voor typesetting",
  ] },
];

const voordelen = [
  { icon: "clock", kop: "Minder tijd", tekst: "Een Bijbel telt al snel meer dan duizend pagina's. De software zet de hele tekst in één keer en doet automatisch voorstellen bij problemen." },
  { icon: "euro", kop: "Lagere kosten", tekst: "Ook een kleine oplage of een eerste uitgave wordt haalbaar. Uitgevers zonder ervaring profiteren van kant-en-klare templates." },
  { icon: "shield-check", kop: "Geen frustratie", tekst: "Geen verspringende verzen of losgeraakte voetnoten. Elke proef wordt op dezelfde manier gezet: wat goed was, blijft goed." },
] as const;

const templates = [
  { naam: "Kerkbijbel", beeld: "tirgumai-template-kerkbijbel", b: 1200, h: 1760, tekst: "Twee kolommen, kruisverwijzingen en duimgrepen in de marge.", alt: "Een pagina uit Johannes 1 in de kerkbijbel-template: twee kolommen, voetnoten en verwijzingen onderaan, duimgreep in de marge" },
  { naam: "Notitiebijbel", beeld: "tirgumai-template-notitiebijbel", b: 1200, h: 1800, tekst: "Eén kolom, versnummers in de kantlijn en notitieregels.", alt: "Een pagina uit Romeinen 1 in de notitiebijbel-template: één kolom met versnummers in de kantlijn en lege notitieregels ernaast" },
  { naam: "Eigen ontwerp", beeld: "tirgumai-template-eigen-ontwerp", b: 1200, h: 1800, tekst: "Naar de voorbeeldpagina van een klant: eigen formaat, letter, kop en notenlijst.", alt: "Een pagina uit Mattheüs 1 in een eigen ontwerp: één brede kolom met een eigen letter en voetnoten onderaan" },
];
const alleTemplates = ["Leesbijbel", "Handbijbel", "Grote letter", "Kerkbijbel", "Kinderbijbel", "Studiebijbel", "Predikantenbijbel", "Toepassingsbijbel", "Notitiebijbel"];

const drukStappen = [
  { kop: "Lever je tekst aan", tekst: "Uit Paratext, als USFM of USX, of als Scripture Burrito." },
  { kop: "Kies de opmaak", tekst: "Een kant-en-klaar template of een ontwerp op maat." },
  { kop: "Bekijk de proef", tekst: "Download als pdf, inclusief detectie van opmaakproblemen." },
  { kop: "Drukcase drukt", tekst: "Het drukbestand gaat naar de pers, Drukcase verzorgt de rest." },
];

const faq = [
  { v: "Schrijft de AI de vertaling?", a: "Dat is mogelijk, als je dat wilt. Met TirgumAI kun je de Hebreeuwse en Griekse grondteksten met één druk op de knop laten vertalen in tientallen doeltalen, op basis van jouw eigen vertaalrichtlijnen. Maar je kunt de ingebouwde AI ook gebruiken als ondersteuning bij het vertalen of om jouw eigen vertaling te controleren." },
  { v: "Welke grondteksten gebruikt TirgumAI?", a: "Open edities van het Hebreeuwse Oude Testament en het Griekse Nieuwe Testament, met Strong's-nummers en grammaticale informatie. Daarnaast vergelijkingsteksten zoals Nestle 1904, Tischendorf en Westcott-Hort, en woordenboeken als Brown-Driver-Briggs, Abbott-Smith en Strong's." },
  { v: "Kunnen we met een team werken?", a: "Ja, een vertaalproject heeft vaak behalve vertalers ook meelezers, reviewers en projectleiders. Zij hebben elk eigen rechten in de software. TirgumAI is echter ook heel goed individueel te gebruiken." },
  { v: "Hoe komt de vertaling bij de lezer?", a: "Je kunt de vertaling als online bijbel publiceren, in een mooi vormgegeven leesomgeving die geschikt is voor mobiel en desktop." },
  { v: "We hebben al een vertaling. In welk formaat leveren we die aan?", a: "Rechtstreeks uit Paratext, als USFM of USX, of als Scripture Burrito. Je hoeft dus niet in TirgumAI te vertalen om de software voor het zetten te gebruiken." },
  { v: "Kunnen we onze Bijbel ook laten drukken?", a: "Ja. TirgumAI zet de complete tekst drukklaar, met afloop en snijtekens, in een kant-en-klaar template of een eigen ontwerp." },
];
---
<Base
  {...pagina("/tirgumai")}
  current="software"
>
  <section class="hero">
    <div class="wrap stack gap-56">
      <nav aria-label="Kruimelpad" class="crumbs">
        <a href="/#producten">Onze software</a>
        <Icon name="chevron-right" size={14} />
        <span>TirgumAI</span>
      </nav>
      <div class="narrow stack gap-24">
        <span class="tag">Beta · voor bijbelvertalers, theologen en uitgevers</span>
        <h1 class="h1 h1-sm">TirgumAI: vers voor vers de Bijbel vertalen, met hulp van AI</h1>
        <p class="lead">Vertaal vanuit de Hebreeuwse en Griekse grondtekst, alleen of met een team, met behulp van AI. Verrijk de vertaling met&nbsp;voetnoten, afbeeldingen en commentaren. Publiceer vervolgens je eigen studiebijbel, online of als drukklare pdf, direct vanuit de software.</p>
        <div class="actions">
          <a href="#op-de-hoogte" class="btn btn-primary"><span>Houd me op de hoogte</span> <Icon name="arrow-right" /></a>
          <a href="#leessite" class="btn btn-secondary">Bekijk een voorbeeld van de leessite</a>
        </div>
      </div>

      <figure class="browser screen vergelijk" data-vergelijk>
        <div class="browser-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="url">app.tirgumai.nl</span>
        </div>
        <div class="beeld">
          <picture>
            <source srcset="/beeld/tirgumai-werkplek-licht.webp" type="image/webp">
            <img src="/beeld/tirgumai-werkplek-licht.png" width="1800" height="1181" alt="De werkplek van TirgumAI bij Genesis 1:8 in de lichte modus: vertaling en Hebreeuwse grondtekst in het midden, woordpaneel rechts">
          </picture>
          <picture class="donker" aria-hidden="true">
            <source srcset="/beeld/tirgumai-werkplek-donker.webp" type="image/webp">
            <img src="/beeld/tirgumai-werkplek-donker.png" width="1800" height="1181" alt="" loading="lazy">
          </picture>
          <span class="modus links" aria-hidden="true">Licht</span>
          <span class="modus rechts" aria-hidden="true">Donker</span>
          <div class="lijn" aria-hidden="true"></div>
          <div class="greep" aria-hidden="true"><Icon name="chevrons-left-right" size={20} /></div>
          <input type="range" class="schuif" min="0" max="100" step="0.5" value="50" aria-label="Schuif tussen de lichte en de donkere modus">
        </div>
      </figure>
    </div>
  </section>

  <section class="section-mist functies">
    <div class="wrap stack gap-40">
      <div class="stack gap-12 midden">
        <p class="eyebrow">Wat TirgumAI uniek maakt</p>
        <h2 class="h2">Vertrouwd vertaalgereedschap, <br class="br-breed">gecombineerd met baanbrekende technologie</h2>
      </div>
      <ol class="strook" aria-label="De zes stappen van het vertaalwerk">
        <div class="ai-kader" aria-hidden="true"><span class="ai-label"><span><Icon name="sparkles" size={14} /> Met AI-ondersteuning</span></span></div>
        {stappen.map((s, i) => (
          <li class:list={["stap", { ai: s.ai }]} style={`--kolom: ${i + 1}`}>
            <div class="bol"><Icon name={s.icon} size={22} /></div>
            <span>{s.label}</span>
          </li>
        ))}
      </ol>
      <div class="card kolommen">
        {groepen.map((g) => (
          <div class="groep stack gap-8">
            <h3 class="eyebrow groep-kop">{g.ai && <Icon name="sparkles" size={14} />}<span>{g.kop}</span></h3>
            <ul class="punten">
              {g.punten.map((p) => <li><Icon name="check" size={16} /><span>{p}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bijzonder">
    <div class="wrap stack gap-96">

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">Voor de vertaler</p>
          <h2 class="h2-sm">Elk woord uitgelegd, op de plek waar je werkt</h2>
          <p class="muted f-tekst">Onder elk vers staat de grondtekst woord voor woord, met transliteratie, betekenis en Strong's-nummer. Klik op een woord en het paneel toont de grammatica, de herkomst, hoe je het eerder vertaalde en wat het glossarium voorschrijft. Geen woordenboeken ernaast, geen tabbladen.</p>
        </div>
        <figure class="figuur">
          <div class="screen gevoerd">
            <picture>
              <source srcset="/beeld/tirgumai-interlineair.webp" type="image/webp">
              <img src="/beeld/tirgumai-interlineair.png" width="1628" height="340" loading="lazy" alt="De interlineaire strook van Genesis 1:8: tien Hebreeuwse woorden met transliteratie, Nederlandse betekenis en Strong's-nummer, het woord voor gewelf geselecteerd">
            </picture>
          </div>
          <figcaption>De grondtekst per woord onder Genesis 1:8.</figcaption>
        </figure>
      </div>

      <div id="leessite" class="feature omgekeerd">
        <figure class="figuur">
          <div class="screen">
            <picture>
              <source srcset="/beeld/tirgumai-leessite.webp" type="image/webp">
              <img src="/beeld/tirgumai-leessite.png" width="1800" height="1125" loading="lazy" alt="De leessite van een vertaalproject op Genesis 1: boekinleiding, sectiekoppen, voetnoten, verwijzingen in de kantlijn en een studiepaneel">
            </picture>
          </div>
          <figcaption>De leessite in de studiemodus: inleiding, verwijzingen, voetnoten, grondtekst.</figcaption>
        </figure>
        <div class="stack gap-16">
          <p class="eyebrow">Voor de lezer</p>
          <h2 class="h2-sm">Van werkvertaling naar studiebijbel, zonder extra werk</h2>
          <p class="muted f-tekst">Wat het team in de werkplek vastlegt, zoals voetnoten, verwijzingen, inleidingen, studienoten en afbeeldingen, staat op de leessite meteen op zijn plek. De lezer kiest zelf: alleen de tekst, of alles erbij. Bronnen en licenties staan netjes op één pagina.</p>
        </div>
      </div>

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">Voor het team</p>
          <h2 class="h2-sm">Consequent vertalen, ook met tien mensen</h2>
          <p class="muted f-tekst">De consistentiecontrole vindt de plekken waar één Nederlands woord voor twee grondwoorden staat, of waar hetzelfde grondwoord verschillend is vertaald. Per knelpunt zie je de verzen, spring je naar de kaart, of markeer je het bewust zo. Rollen voor vertaler, reviewer en beheerder houden het werk op orde.</p>
        </div>
        <figure class="figuur">
          <div class="screen">
            <picture>
              <source srcset="/beeld/tirgumai-consistentie.webp" type="image/webp">
              <img src="/beeld/tirgumai-consistentie.png" width="1800" height="1125" loading="lazy" alt="De consistentiecontrole, tabblad Begrippen: vier Nederlandse woorden die voor meer dan één grondwoord staan, met de verzen per grondwoord">
            </picture>
          </div>
          <figcaption>Consistentie › Begrip 'licht' in Genesis 1.</figcaption>
        </figure>
      </div>

    </div>
  </section>

  <section id="drukwerk" class="drukwerk">
    <div class="wrap stack gap-56">
      <div class="narrow stack gap-16">
        <p class="partners">
          <img src="/beeld/drukcase-logo.png" srcset="/beeld/drukcase-logo.webp" width="480" height="296" alt="Drukcase" class="partner-drukcase">
          <Icon name="x" size={14} class="partner-kruis" />
          <span class="partner-tirgumai"><img src="/logo/jona-mark.svg" alt="" width="230" height="226">TirgumAI</span>
        </p>
        <p class="eyebrow">Van vertaling tot gedrukte Bijbel</p>
        <h2 class="h2">Drukklaar gezet, zonder maanden opmaakwerk</h2>
        <p class="muted f-tekst">Dezelfde software zet ook complete Bijbels en studiebijbels. Koppen, hoofdstuk- en versnummers, voetnoten en kruisverwijzingen, kolommen in balans, afloop en snijtekens: de hele tekst in één keer. Drukwerkpartner Drukcase, specialist in Bijbels, gebruikt TirgumAI al voor het zetten. Een compleet Bulgaars Nieuw Testament is ermee gemaakt en andere uitgaven zijn in voorbereiding.</p>
      </div>

      <ul class="voordelen">
        {voordelen.map((v) => (
          <li class="stack gap-10">
            <div class="voordeel-kop"><span class="rondje"><Icon name={v.icon} size={18} /></span><h3>{v.kop}</h3></div>
            <p class="muted">{v.tekst}</p>
          </li>
        ))}
      </ul>

      <div class="stack gap-24">
        <div class="card template-groot">
          <div class="template-beeld">
            <picture>
              <source srcset="/beeld/tirgumai-template-studiebijbel.webp" type="image/webp">
              <img src="/beeld/tirgumai-template-studiebijbel.png" width="2000" height="1500" loading="lazy" alt="Een spread uit Genesis 1 tot 3 in de studiebijbel-template: twee kolommen bijbeltekst met tekstnoten en studienoten onderaan elke pagina">
            </picture>
          </div>
          <div class="stack gap-12">
            <p class="eyebrow">Template</p>
            <h3 class="h3 h3-24">Studiebijbel</h3>
            <p class="muted">Twee kolommen, met tekstnoten en studienoten onderaan elke pagina. De software zet automatisch:</p>
            <ul class="checks checks-15">
              <li><Icon name="check" size={16} /><span>koppen, hoofdstuk- en versnummers</span></li>
              <li><Icon name="check" size={16} /><span>voetnoten en kruisverwijzingen</span></li>
              <li><Icon name="check" size={16} /><span>studienoten bij het juiste vers</span></li>
              <li><Icon name="check" size={16} /><span>kolommen in balans, met afbreking</span></li>
              <li><Icon name="check" size={16} /><span>afloop en snijtekens voor de drukker</span></li>
            </ul>
          </div>
        </div>
        <div class="templates">
          {templates.map((t) => (
            <div class="card template stack gap-12">
              <div class="template-beeld staand">
                <picture>
                  <source srcset={`/beeld/${t.beeld}.webp`} type="image/webp">
                  <img src={`/beeld/${t.beeld}.png`} width={t.b} height={t.h} loading="lazy" alt={t.alt}>
                </picture>
              </div>
              <h3 class="h3-19">{t.naam}</h3>
              <p class="muted template-tekst">{t.tekst}</p>
            </div>
          ))}
        </div>
        <p class="alle"><span class="muted">Alle templates:</span> {alleTemplates.map((n) => <span class="pil">{n}</span>)}</p>
      </div>

      <div class="druk-onder">
        <ol class="drukstappen">
          {drukStappen.map((st, i) => (
            <li class="stack gap-6">
              <div class="drukstap-kop"><span class="num">{i + 1}</span><h3>{st.kop}</h3></div>
              <p class="muted">{st.tekst}</p>
            </li>
          ))}
        </ol>
        <div class="card sheet stack gap-12">
          <p class="eyebrow">Informatiesheet</p>
          <p class="sheet-tekst">Alles over drukken met TirgumAI en Drukcase op twee pagina's, om door te sturen binnen je organisatie.</p>
          <div class="sheet-links">
            <a href="/downloads/tirgumai-informatiesheet-drukcase.pdf" class="btn btn-secondary" download><Icon name="download" size={16} /> Nederlands (pdf)</a>
            <a href="/downloads/tirgumai-information-sheet-drukcase-en.pdf" class="btn btn-secondary" download hreflang="en"><Icon name="download" size={16} /> English (pdf)</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="op-de-hoogte" class="hoogte">
    <div class="wrap">
      <div class="kaart-navy on-navy">
        <img src="/logo/jona-mark.svg" alt="" aria-hidden="true" class="watermark" width="480" height="480">
        <div class="stack gap-16 kaart-tekst">
          <p class="eyebrow">Op de hoogte blijven</p>
          <h2 class="kaart-kop">Als eerste horen wanneer TirgumAI beschikbaar komt?</h2>
          <p class="kaart-lead">TirgumAI is in ontwikkeling en wordt op dit moment getest met een kleine groep vertalers. Laat je e-mailadres achter en we mailen je bij de belangrijke stappen: nieuwe functies, de start van de open beta en de lancering. Niet vaker dan nodig, en afmelden kan altijd.</p>
        </div>
        <form id="aanvraag" class="form kaart-form" method="post" action="/api/nieuwsbrief-tirgumai" data-form="nieuwsbrief-tirgumai" novalidate>
          <ul class="checks checks-navy">
            <li><Icon name="check" size={16} /><span>Nieuws over nieuwe functies</span></li>
            <li><Icon name="check" size={16} /><span>Een uitnodiging voor de open beta</span></li>
            <li><Icon name="check" size={16} /><span>Bericht bij de lancering</span></li>
          </ul>
          <input type="hidden" name="_bron" value="">
          <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="field">
            <label for="nb-email">E-mailadres</label>
            <input id="nb-email" name="email" type="email" autocomplete="email" inputmode="email" required>
            <span class="err" data-error-for="email"></span>
          </div>
          <p class="form-status" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-accent btn-block btn-52">Houd me op de hoogte <Icon name="arrow-right" /></button>
          <p class="note">We gebruiken je adres alleen voor nieuws over TirgumAI. Liever mailen? <a href="mailto:ruben@jonacommunicatie.nl">ruben@jonacommunicatie.nl</a></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow stack gap-32">
      <h2 class="faq-kop">Veelgestelde vragen</h2>
      <div class="faq">
        {faq.map((f) => (
          <div class="vraag stack gap-6">
            <h3>{f.v}</h3>
            <p class="muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FormScript />
</Base>

<script>
  // De schuif tussen de lichte en de donkere modus in het eerste scherm.
  for (const fig of document.querySelectorAll<HTMLElement>("[data-vergelijk]")) {
    const input = fig.querySelector<HTMLInputElement>("input[type=range]");
    if (!input) continue;
    const zet = () => fig.style.setProperty("--pos", `${input.value}%`);
    input.addEventListener("input", zet);
    zet();
  }
</script>

<style>
  .hero { padding: 96px 0 64px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 4px; }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--mist);
  }
  .dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: var(--border); }
  .url {
    margin-left: 12px;
    flex: 1;
    min-height: 28px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 13px;
    color: var(--muted);
  }

  /* licht/donker-schuif */
  .vergelijk { --pos: 50%; margin: 0; }
  .beeld { position: relative; overflow: hidden; background: var(--mist); }
  .beeld picture { display: block; }
  .beeld .donker {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }
  .beeld .donker img { height: 100%; object-fit: cover; }
  .modus {
