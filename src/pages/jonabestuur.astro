---
import { pagina } from "../lib/paginas";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const AANMELDEN = "https://jonabestuur.nl/aanmelden";

const stappen = [
  { icon: "calendar", titel: "De agenda maken", tekst: "De vaste punten staan er al, zoals de opening en de rondvraag. Bestuursleden stellen zelf een punt voor, en openstaande acties komen vanzelf terug." },
  { icon: "users", titel: "Vergaderen, punt voor punt", tekst: "Bij elk punt maar drie vragen: wat is besproken, wat is besloten en wie doet wat. Alles wordt meteen bewaard." },
  { icon: "file-text", titel: "Notulen vaststellen", tekst: "Na het laatste punt staan de conceptnotulen klaar. Jij leest na, deelt ze ter controle en stelt ze de volgende keer vast." },
  { icon: "search", titel: "Besluiten terugvinden", tekst: "Elk besluit krijgt een nummer en staat in het besluitenregister. Je typt een woord en je hebt het." },
] as const;

const vragen = [
  { label: "Besproken", vraag: "Wat is er besproken?", tekst: "Een paar zinnen is genoeg." },
  { label: "Besloten", vraag: "Wat is besloten?", tekst: "Het besluit krijgt meteen een nummer." },
  { label: "Wie doet wat", vraag: "Wie doet wat?", tekst: "Een actie, met een naam en een datum." },
];

const meer = [
  { icon: "mail", titel: "Herinneringen bij acties", tekst: "Een e-mail als de datum van een actie nadert." },
  { icon: "lock", titel: "Vertrouwelijke punten", tekst: "Alleen zichtbaar voor wie ze mag zien." },
  { icon: "circle-plus", titel: "Punt voorstellen", tekst: "Bestuursleden zetten zelf een punt op de agenda." },
  { icon: "book-open", titel: "Doorzoekbaar archief", tekst: "Alle vergaderingen en stukken, terug te vinden op één woord." },
  { icon: "download", titel: "Excel en pdf", tekst: "Het register en de acties als Excel, de notulen als pdf." },
  { icon: "monitor", titel: "Niets te installeren", tekst: "Werkt in de browser, op computer, tablet en telefoon." },
] as const;

const veilig = [
  "Inloggen gaat altijd met een tweede stap op je telefoon",
  "De gegevens van jullie bestuur zijn strikt gescheiden van die van anderen",
  "Bijlagen worden versleuteld bewaard, en elke nacht wordt er een back-up gemaakt",
  "Een bestuurslid ziet alleen wat gedeeld is",
  "Vastgestelde notulen en besluiten kan niemand stilletjes wijzigen",
  "Je kunt alles van jullie bestuur in één keer exporteren",
];

const faq = [
  { v: "Voor wie is Jona Bestuur bedoeld?", a: "Voor kleine besturen, zoals van een stichting of vereniging, waar de secretaris het werk naast een baan doet. Vergadert jullie bestuur een paar keer per jaar en wil je terug kunnen vinden wat er besloten is, dan is het voor jou gemaakt." },
  { v: "Moet de rest van het bestuur er ook mee werken?", a: "Dat kan, maar het hoeft niet. Bestuursleden lezen de agenda en de notulen mee, stellen zelf een punt voor en zien hun eigen acties. Een bestuurslid ziet alleen wat met hem of haar gedeeld is." },
  { v: "Moet ik iets installeren?", a: "Nee. Je logt in via jonabestuur.nl, op je computer, tablet of telefoon. Er is niets te downloaden of bij te werken." },
  { v: "Kan ik ook vergaderen met alleen een tablet of telefoon?", a: "Ja. De agenda, de vergadermodus en het besluitenregister werken ook op een klein scherm, en alles wat je invult wordt meteen bewaard." },
  { v: "Hoe veilig zijn onze bestuursstukken?", a: "Daar is Jona Bestuur op gebouwd. Inloggen gaat altijd met een tweede stap op je telefoon, de gegevens van jullie bestuur zijn strikt gescheiden van die van anderen, bijlagen worden versleuteld bewaard en elke nacht wordt er een back-up gemaakt." },
];
---
<Base
  {...pagina("/jonabestuur")}
  current="software"
>
  <section class="hero">
    <div class="wrap stack gap-56">
      <nav aria-label="Kruimelpad" class="crumbs">
        <a href="/software">Onze software</a>
        <Icon name="chevron-right" size={14} />
        <span>Jona Bestuur</span>
      </nav>
      <div class="narrow stack gap-24">
        <span class="tag">Nu beschikbaar · 14 dagen gratis proberen</span>
        <h1 class="h1 h1-sm">Jona Bestuur: agenda, notulen en besluiten op één plek.</h1>
        <p class="lead">De secretaris van een klein bestuur doet het meeste werk 's avonds, naast werk en gezin. De agenda maken, meeschrijven tijdens de vergadering, de notulen uitwerken en onthouden wat er besloten is. Jona Bestuur zet het allemaal op één plek. Zo eenvoudig dat je er geen handleiding voor nodig hebt, en de rest van het bestuur ook niet.</p>
        <div class="actions">
          <a href={AANMELDEN} rel="noopener" class="btn btn-primary"><span>Probeer 14 dagen gratis</span> <Icon name="arrow-right" /></a>
          <a href="https://jonabestuur.nl" rel="noopener" class="btn btn-secondary">Naar jonabestuur.nl</a>
        </div>
      </div>
      <div class="apparaten">
        <figure class="browser screen">
          <div class="browser-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="url">jonabestuur.nl</span>
          </div>
          <picture>
            <source srcset="/beeld/jonabestuur-vergadermodus.webp" type="image/webp">
            <img src="/beeld/jonabestuur-vergadermodus.png" width="1600" height="1000" alt="De vergadermodus van Jona Bestuur: links de agenda, rechts agendapunt 6, Begroting 2027, met drie vragen: wat is er besproken, wat is besloten en wie doet wat">
          </picture>
        </figure>
        <div class="telefoon">
          <picture>
            <source srcset="/beeld/jonabestuur-mobiel-punt.webp" type="image/webp">
            <img src="/beeld/jonabestuur-mobiel-punt.png" width="780" height="1688" alt="Een agendapunt in de vergadermodus op de telefoon">
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section-mist stappen-sectie">
    <div class="wrap stack gap-40">
      <div class="narrow stack gap-12">
        <p class="eyebrow">Van agenda tot besluit</p>
        <h2 class="h2">Alles wat een secretaris doet, op één plek</h2>
      </div>
      <ol class="tijdlijn">
        {stappen.map((s, i) => (
          <li>
            <div class="bol"><Icon name={s.icon} size={22} /></div>
            <p class="eyebrow">Stap {i + 1}</p>
            <h3>{s.titel}</h3>
            <p class="muted">{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bijzonder">
    <div class="wrap stack gap-80">

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">De vergadermodus</p>
          <h2 class="h2-sm">Je vergadert, één punt tegelijk</h2>
          <p class="muted f-tekst">Links de agenda, rechts het punt waar jullie nu zijn. Je vult in wat nodig is en gaat door naar het volgende punt. Alles wordt meteen bewaard, ook op een tablet of telefoon.</p>
        </div>
        <ul class="vragen">
          {vragen.map((v) => (
            <li>
              <p class="eyebrow">{v.label}</p>
              <p class="vraag-kop">{v.vraag}</p>
              <p class="muted">{v.tekst}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="feature omgekeerd">
        <figure class="screen">
          <picture>
            <source srcset="/beeld/jonabestuur-notulen.webp" type="image/webp">
            <img src="/beeld/jonabestuur-notulen.png" width="1600" height="1000" loading="lazy" alt="Notulen van 9 november, ter controle gedeeld, met een besluit en een actie bij het punt Begroting 2027">
          </picture>
        </figure>
        <div class="stack gap-16">
          <p class="eyebrow">De notulen</p>
          <h2 class="h2-sm">De notulen schrijven zich bijna vanzelf</h2>
          <p class="muted f-tekst">Na het laatste punt staan de conceptnotulen klaar, met de besluiten en acties erin. Jij leest ze na, deelt ze ter controle met het bestuur en stelt ze de volgende keer vast. Daarna liggen ze vast, ook als pdf.</p>
        </div>
      </div>

      <div class="feature">
        <div class="stack gap-16">
          <p class="eyebrow">Besluitenregister</p>
          <h2 class="h2-sm">“Wat hadden we nou afgesproken over de huur?”</h2>
          <p class="muted f-tekst">Elk besluit staat in het besluitenregister, met een nummer en het agendapunt waar het vandaan komt. Je typt een woord en je hebt het. Zo hoeft niemand meer door oude notulen te bladeren.</p>
        </div>
        <figure class="screen">
          <picture>
            <source srcset="/beeld/jonabestuur-besluiten.webp" type="image/webp">
            <img src="/beeld/jonabestuur-besluiten.png" width="1600" height="1000" loading="lazy" alt="Het besluitenregister met vier besluiten en het spoor van besluit 2026-004">
          </picture>
        </figure>
      </div>

      <div class="feature omgekeerd">
        <div class="illu">
          <div class="telefoon">
            <picture>
              <source srcset="/beeld/jonabestuur-mobiel-agenda.webp" type="image/webp">
              <img src="/beeld/jonabestuur-mobiel-agenda.png" width="780" height="1688" loading="lazy" alt="De agenda op de telefoon">
            </picture>
          </div>
          <div class="telefoon laag">
            <picture>
              <source srcset="/beeld/jonabestuur-mobiel-besluiten.webp" type="image/webp">
              <img src="/beeld/jonabestuur-mobiel-besluiten.png" width="780" height="1688" loading="lazy" alt="Het besluitenregister op de telefoon">
            </picture>
          </div>
        </div>
        <div class="stack gap-16">
          <p class="eyebrow">Ook op je telefoon</p>
          <h2 class="h2-sm">De agenda en de besluiten altijd bij de hand</h2>
          <p class="muted f-tekst">Even nakijken wat er de volgende keer op de agenda staat, of wat er vorig jaar besloten is? Op je telefoon heb je het zo gevonden. Ook de rest van het bestuur kan meelezen.</p>
        </div>
      </div>

      <div class="stack gap-32">
        <div class="narrow stack gap-12">
          <p class="eyebrow">En meer, als het nodig is</p>
          <h2 class="h2-sm">Het zit er allemaal in, en het staat niet in de weg</h2>
        </div>
        <ul class="meer">
          {meer.map((m) => (
            <li class="card">
              <span class="ico"><Icon name={m.icon} size={20} /></span>
              <h3>{m.titel}</h3>
              <p class="muted">{m.tekst}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="card veilig">
        <div class="stack gap-12 veilig-tekst">
          <span class="ico"><Icon name="shield-check" size={20} /></span>
          <h2 class="h2-sm">Bestuursstukken zijn vertrouwelijk</h2>
          <p class="muted">Daar is Jona Bestuur op gebouwd.</p>
        </div>
        <ul class="checks veilig-lijst">
          {veilig.map((v) => (
            <li><Icon name="check" /><span>{v}</span></li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <section id="proberen" class="section section-mist">
    <div class="wrap grid">
      <div class="stack gap-28">
        <div class="stack gap-12">
          <p class="eyebrow">Wat het kost</p>
          <h2 class="h2">Eerst 14 dagen gratis proberen</h2>
          <p class="muted f-tekst">Je probeert Jona Bestuur eerst rustig uit, met je eigen bestuur en je eigen vergaderingen. Bevalt het, dan kies je of je per jaar of per maand betaalt. Eén prijs voor het hele bestuur samen, en alles zit erin.</p>
        </div>
        <div class="card persoonlijk">
          <picture>
            <source srcset="/beeld/jonagiften-ruben.webp" type="image/webp">
            <img src="/beeld/jonagiften-ruben.png" width="900" height="816" loading="lazy" alt="Getekend portret van Ruben Hadders">
          </picture>
          <div class="stack gap-6">
            <p>Twijfel je of het past bij jullie bestuur? Bel of mail me gerust, ik denk graag met je mee.</p>
            <p class="muted p-naam">Ruben Hadders, ontwikkelaar van Jona Bestuur</p>
            <div class="contact"><a href="tel:+31332301737">033 230 17 37</a><a href="mailto:ruben@jonacommunicatie.nl">ruben@jonacommunicatie.nl</a></div>
          </div>
        </div>
      </div>

      <div class="card prijskaart">
        <h3 class="h3 h3-22">Jona Bestuur voor jullie bestuur</h3>
        <div class="opties">
          <div class="optie uitgelicht">
            <span class="wat">Per jaar betalen</span>
            <span class="hoeveel">€ 9,95 <small>per maand</small></span>
            <span class="extra">€ 119,40 per jaar</span>
          </div>
          <div class="optie">
            <span class="wat">Per maand betalen</span>
            <span class="hoeveel">€ 12,95 <small>per maand</small></span>
            <span class="extra muted">per maand afgerekend</span>
          </div>
        </div>
        <ul class="checks">
          <li><Icon name="check" /><span>14 dagen gratis, met je eigen vergaderingen</span></li>
          <li><Icon name="check" /><span>Voor het hele bestuur samen, met alle functies</span></li>
          <li><Icon name="check" /><span>Persoonlijke hulp als je ergens niet uitkomt</span></li>
          <li><Icon name="check" /><span>Prijzen inclusief btw</span></li>
        </ul>
        <a href={AANMELDEN} rel="noopener" class="btn btn-primary btn-52"><span>Start je gratis proefperiode</span> <Icon name="arrow-right" /></a>
        <p class="note">Aanmelden duurt twee minuten en gaat via <a href="https://jonabestuur.nl" rel="noopener">jonabestuur.nl</a>.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow stack gap-32">
      <h2 class="faq-kop">Veelgestelde vragen</h2>
      <div class="faq">
        {faq.map((f) => (
          <div class="vraag stack gap-6">
            <h3>{f.v}</h3>
            <p class="muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 96px 0 72px; overflow: hidden; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 4px; }

  /* laptop met telefoon ervoor */
  .apparaten { position: relative; padding-right: 9%; padding-bottom: 40px; }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--mist);
  }
  .dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: var(--border); }
  .url {
    margin-left: 12px;
    flex: 1;
    min-height: 28px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 13px;
    color: var(--muted);
  }
  .telefoon {
    background: var(--navy-900);
    padding: 9px;
    border-radius: 38px;
    box-shadow: 0 30px 60px -20px rgba(4, 32, 47, 0.45);
  }
  .telefoon img { display: block; width: 100%; height: auto; border-radius: 30px; }
  .apparaten .telefoon { position: absolute; right: 0; bottom: 0; width: 23%; min-width: 150px; }

  /* tijdlijn */
  .stappen-sectie { padding: 80px 0; }
  .tijdlijn {
    list-style: none;
    padding: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .tijdlijn::before {
    content: "";
    position: absolute;
    left: 28px;
    right: calc(25% + 28px);
    top: 28px;
    height: 2px;
    background: var(--teal);
    opacity: 0.45;
  }
  .tijdlijn li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-right: 24px;
  }
  .tijdlijn h3 { font-size: 20px; font-weight: 500; line-height: 1.3; }
  .tijdlijn p.muted { font-size: 16px; }
  .bol {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 2px solid var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal-700);
    box-shadow: 0 0 0 6px var(--mist);
  }

  /* uitgelichte functies */
  .bijzonder { padding: 88px 0 72px; }
  .gap-80 { gap: 80px; }
  .gap-32 { gap: 32px; }
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: center;
  }
  .feature > * { min-width: 0; }
  .f-tekst { font-size: 18px; }
  .illu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 360px;
  }
  .illu .telefoon { width: 200px; }
  .illu .telefoon.laag { margin-top: 70px; }
  .pijl { color: var(--teal); flex-shrink: 0; }
  .melding {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-small);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    width: 220px;
  }
  .m-kop { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; }
  .m-regel { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .m-bedrag { font-family: var(--font-serif); font-size: 22px; }
  .m-ideal {
    padding: 1px 8px;
    border-radius: var(--r-pill);
    background: var(--teal-100);
    color: var(--teal-800);
    font-size: 11px;
    font-weight: 500;
  }

  /* en meer */
  .meer {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .meer li { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .ico {
    width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    background: var(--teal-100);
    color: var(--teal-800);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .meer h3 { font-size: 18px; font-weight: 500; line-height: 1.3; }
  .meer p { font-size: 15.5px; }

  /* prijs */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: start;
  }
  .grid > * { min-width: 0; }
  .h3-22 { font-size: 22px; }
  .prijskaart { padding: 32px; box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 22px; }
  .opties { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .optie { border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
  .optie.uitgelicht { border-color: var(--teal); background: var(--teal-100); }
  .wat { font-size: 13px; color: var(--muted); }
  .hoeveel { font-family: var(--font-serif); font-size: 30px; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .hoeveel small { font-family: var(--font-sans); font-size: 14px; color: var(--muted); }
  .extra { font-size: 13px; color: var(--teal-800); }
  .extra.muted { color: var(--muted); }
  .btn-52 { min-height: 52px; }
  .note { font-size: 13px; color: var(--muted); }
  .persoonlijk { padding: 24px; display: flex; gap: 20px; align-items: center; }
  .persoonlijk img {
    display: block;
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: var(--r-pill);
    background: var(--mist);
    flex-shrink: 0;
  }
  .p-naam { font-size: 15px; }
  .contact { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 15px; }

  /* faq */
  .faq-kop {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 31px;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--teal-700);
  }
  .faq { display: flex; flex-direction: column; }
  .vraag { padding: 24px 0; border-top: 1px solid var(--border); }
  .vraag:last-child { border-bottom: 1px solid var(--border); }
  .vraag h3 { font-size: 19px; font-weight: 500; }

  /* drie vragen per agendapunt */
  .vragen { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .vragen li {
    background: var(--white);
    border: 2px dashed var(--teal-300);
    border-radius: var(--r-card);
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .vraag-kop { font-family: var(--font-serif); font-weight: 500; font-size: 21px; line-height: 1.3; }

  /* veilig */
  .veilig {
    padding: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 56px;
    align-items: start;
    background: var(--mist);
  }
  .veilig > * { min-width: 0; }

  @media (max-width: 1023px) {
    .tijdlijn { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; }
    .tijdlijn::before { display: none; }
    .meer { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .hero { padding: 64px 0 48px; }
    .stappen-sectie { padding: 64px 0; }
    .bijzonder { padding: 64px 0 40px; }
    .gap-80 { gap: 56px; }
