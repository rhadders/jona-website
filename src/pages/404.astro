---
import Base from "../layouts/Base.astro";
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <section class="nf">
    <div class="wrap narrow stack gap-24">
      <p class="eyebrow">404</p>
      <h1 class="h1 h1-sm">Deze pagina is er niet</h1>
      <p class="lead">Misschien is de link verouderd of zit er een tikfout in. Via de homepage vind je alles terug.</p>
      <a href="/" class="btn btn-primary self-start">Naar de homepage</a>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 128px 0 160px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .self-start { align-self: flex-start; }
  @media (max-width: 767px) { .nf { padding: 72px 0 96px; } }
</style>
