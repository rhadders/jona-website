---
import Base from "../layouts/Base.astro";
import { ui } from "../i18n/ui";
import { taalUitPad } from "../i18n/talen";
import { link } from "../lib/paginas";
// Eén 404 voor de hele site, in de taal van het adres dat niet bestaat.
const taal = taalUitPad(Astro.url.pathname);
const t = ui(taal).nietGevonden;
---
<Base title={t.title} description={t.description} noindex>
  <section class="nf">
    <div class="wrap narrow stack gap-24">
      <p class="eyebrow">404</p>
      <h1 class="h1 h1-sm">{t.kop}</h1>
      <p class="lead">{t.tekst}</p>
      <a href={link("home", taal)} class="btn btn-primary self-start">{t.knop}</a>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 128px 0 160px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .self-start { align-self: flex-start; }
  @media (max-width: 767px) { .nf { padding: 72px 0 96px; } }
</style>
