---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
export const prerender = false;

const soort = Astro.url.searchParams.get("soort");
const teksten: Record<string, { kop: string; tekst: string }> = {
  kennismaking: { kop: "Dank je, we nemen contact op", tekst: "Je aanvraag voor een kennismaking is binnen. Binnen twee werkdagen hoor je van ons om een moment te prikken." },
  "ai-scan": { kop: "Dank je, de aanvraag is binnen", tekst: "We nemen binnen twee werkdagen contact op om een dag te prikken en af te stemmen wie er bij jullie bij moeten zijn." },
  testgebruiker: { kop: "Welkom bij de beta", tekst: "Je aanmelding als testgebruiker van ActueleGegevens.nl is binnen. Binnen twee werkdagen nemen we contact op om je account klaar te zetten." },
  "nieuwsbrief-tirgumai": { kop: "Dank je, we houden je op de hoogte", tekst: "Je e-mailadres is binnen. Zodra er nieuws is over TirgumAI, hoor je het als eerste. We gebruiken je adres alleen daarvoor." },
  "beta-selaread": { kop: "Welkom bij de beta-test van Selaread", tekst: "Je aanmelding is binnen. Zodra de beta-test start, krijg je van ons een uitnodiging met je toegang. Met uitgevers nemen we vooraf persoonlijk contact op." },
};
const t = teksten[soort ?? ""] ?? { kop: "Dank je wel", tekst: "Je bericht is binnen. We nemen binnen twee werkdagen contact op." };
---
<Base title="Bedankt" description="Je bericht is binnen." noindex>
  <section class="bedankt">
    <div class="wrap narrow stack gap-24">
      <span class="vink"><Icon name="check" size={28} /></span>
      <h1 class="h1 h1-sm">{t.kop}</h1>
      <p class="lead">{t.tekst}</p>
      <p class="muted">Toch nog iets kwijt? Mail naar <a href="mailto:info@jonatechnologie.nl">info@jonatechnologie.nl</a>.</p>
      <a href="/" class="btn btn-outline self-start">Terug naar de homepage</a>
    </div>
  </section>
</Base>

<style>
  .bedankt { padding: 128px 0 160px; }
  .h1-sm { font-size: clamp(34px, 4.8vw, 52px); }
  .vink {
    width: 56px; height: 56px;
    border-radius: var(--r-pill);
    background: var(--teal-100);
    color: var(--teal-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .self-start { align-self: flex-start; }
  @media (max-width: 767px) { .bedankt { padding: 72px 0 96px; } }
</style>
