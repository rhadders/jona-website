# Kopieer naar .env voor lokaal gebruik. Op de server (Hostinger) staan deze
# als omgevingsvariabelen van de Node.js-app, nooit in de code.

# Optionele toegangscode. De site is standaard openbaar; met TOEGANG=aan
# staat de hele site achter de code (standaard 555555).
# TOEGANG=aan
# TOEGANGSCODE=555555
# TOEGANG_GEHEIM=       optioneel: eigen sleutel voor de cookie-handtekening

# Formulieren: opslag in de Supabase-stack van Jona BI (Dokploy op de VPS);
# de service-rolesleutel blijft op de server.
SUPABASE_URL=https://jona-bi-supabase-9e7a69-145-14-158-221.sslip.io
SUPABASE_SERVICE_ROLE_KEY=

# Formulieren: mail via de Hostinger Mail API vanaf de mailbox MAIL_FROM.
# Token: hPanel → e-maildomein jonatechnologie.nl → Agentic Mail → API access.
HOSTINGER_MAIL_TOKEN=
MAIL_FROM=mail@jonatechnologie.nl
MAIL_TO=mail@jonatechnologie.nl
# HOSTINGER_MAIL_MAILBOX_ID=   optioneel: de resource-id (AC…) van de mailbox, anders opgezocht
